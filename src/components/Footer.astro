---
import { profile } from '~/data/profile';

const updated = new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'America/New_York' });
---

<footer class="ft">
  <p class="engraved">{profile.name} · Boston, MA</p>
  <p class="engraved ft-right">
    <span>Updated {updated}</span>
    <a href="/uses">Uses</a>
    <a href="https://github.com/archit2901/portfolio" target="_blank" rel="noopener noreferrer">Source</a>
  </p>
</footer>

<style>
  .ft {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1.5rem var(--pad) 1.75rem;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .ft p { margin: 0; }
  .ft-right { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .ft a {
    color: inherit;
    text-decoration: none;
  }
  .ft a:hover { color: rgb(var(--ink)); text-decoration: underline; }
</style>
