---
import { sections } from '~/data/sections';
import { profile, links } from '~/data/profile';
import ThemeSwitch from '~/components/ThemeSwitch.astro';
import Icon from '~/components/Icon.astro';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const href = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header class="nav" data-nav>
  <div class="nav-row">
    <a href="/" class="nav-mark">{profile.name}</a>

    <nav aria-label="Sections" class="nav-sel">
      <ol>
        {sections.map((s, i) => (
          <li>
            <a href={href(s.id)} data-nav-link={s.id}>
              <span class="figure nav-pos" aria-hidden="true">{i + 1}</span>{s.label}
            </a>
          </li>
        ))}
      </ol>
      <span class="nav-knob" aria-hidden="true"></span>
    </nav>

    <div class="nav-tools">
      <span class="nav-switch"><ThemeSwitch /></span>
      <button type="button" class="key nav-k" data-palette-open aria-label="Open command palette (⌘K)">
        <span aria-hidden="true">⌘K</span>
      </button>
      <a href={links.resume} download={links.resumeFileName} class="key key-accent nav-resume">
        <Icon name="download" size={16} />Résumé
      </a>
      <button type="button" class="key nav-menu" aria-expanded="false" aria-controls="nav-panel" data-nav-menu>
        <Icon name="menu" size={18} /><span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <div id="nav-panel" class="nav-panel" hidden>
    <ol>
      {sections.map((s, i) => (
        <li>
          <a href={href(s.id)} data-nav-close>
            <span class="figure nav-pos" aria-hidden="true">{i + 1}</span>{s.label}
          </a>
        </li>
      ))}
    </ol>
    <div class="nav-panel-foot">
      <ThemeSwitch />
      <a href="/projects" class="key" data-nav-close>All projects</a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const nav = document.querySelector('[data-nav]');
    if (!nav) return;

    // Stuck shadow
    const onScroll = () => nav.toggleAttribute('data-stuck', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Mobile menu
    const btn = nav.querySelector('[data-nav-menu]');
    const panel = document.getElementById('nav-panel');
    const setOpen = (open) => {
      if (!btn || !panel) return;
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    btn && btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    nav.querySelectorAll('[data-nav-close]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

    // ⌘K key opens the palette
    nav.querySelectorAll('[data-palette-open]').forEach((b) =>
      b.addEventListener('click', () => window.dispatchEvent(new CustomEvent('palette:open'))),
    );

    // Selector position follows the section in view. Sections come after the
    // nav in the document, so wire this once the DOM is parsed.
    const initSelector = () => {
    const links = Array.from(nav.querySelectorAll('[data-nav-link]'));
    const targets = links.map((l) => document.getElementById(l.dataset.navLink)).filter(Boolean);
    if (!targets.length || !('IntersectionObserver' in window)) return;
    // One selector knob slides between positions instead of per-link underlines.
    const sel = nav.querySelector('.nav-sel');
    const knob = nav.querySelector('.nav-knob');
    let current = null;
    const placeKnob = () => {
      if (!knob || !sel) return;
      const a = current && links.find((l) => l.dataset.navLink === current);
      if (!a || !a.offsetParent) { knob.style.opacity = '0'; return; }
      const base = sel.getBoundingClientRect();
      const r = a.getBoundingClientRect();
      knob.style.opacity = '1';
      knob.style.transform = `translateX(${r.left - base.left}px) scaleX(${r.width / 100})`;
    };
    const visible = new Map();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => visible.set(en.target.id, en.isIntersecting ? en.intersectionRatio : 0));
      let best = null, ratio = 0;
      visible.forEach((r, id) => { if (r > ratio) { ratio = r; best = id; } });
      current = best;
      links.forEach((l) => {
        if (l.dataset.navLink === best) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
      placeKnob();
    }, { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.01, 0.25, 0.5] });
    targets.forEach((t) => io.observe(t));
    window.addEventListener('resize', placeKnob);
    document.fonts && document.fonts.ready.then(placeKnob);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSelector);
    else initSelector();
  })();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(var(--plate));
    border-radius: inherit;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: 1px solid rgb(var(--seam));
    box-shadow: 0 1px 0 rgb(var(--seam-hi));
    transition: box-shadow 200ms ease;
  }
  .nav[data-stuck] {
    box-shadow: 0 1px 0 rgb(var(--seam-hi)), 0 10px 24px -18px rgb(0 0 0 / 0.35);
  }
  .nav-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: var(--nav-h);
    padding: 0 var(--pad);
  }
  .nav-mark {
    font-weight: 720;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: rgb(var(--ink));
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }
  .nav-sel { display: none; }
  .nav-sel ol, .nav-panel ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-sel ol {
    display: flex;
    gap: 1.5rem;
  }
  .nav-sel a, .nav-panel a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 640;
    font-stretch: 80%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--ink-2));
    text-decoration: none;
    padding: 0.75rem 0;
    white-space: nowrap;
  }
  .nav-pos {
    font-size: 0.6875rem;
    font-weight: 600;
    color: rgb(var(--ink-3));
  }
  .nav-sel a:hover { color: rgb(var(--ink)); }
  .nav-sel a[aria-current='true'] { color: rgb(var(--ink)); }
  .nav-sel { position: relative; }
  .nav-knob {
    position: absolute;
    left: 0;
    bottom: 0.375rem;
    width: 100px;
    height: 2px;
    border-radius: 1px;
    background: rgb(var(--ink));
    transform-origin: left center;
    opacity: 0;
    pointer-events: none;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1), opacity 200ms ease;
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .nav-switch, .nav-k { display: none; }
  .nav-switch { align-items: center; }
  .nav-k {
    min-width: 2.75rem;
    padding: 0.5rem 0.625rem;
    font-size: 0.8125rem;
  }
  .nav-resume { padding: 0.5rem 0.875rem; }
  .nav-menu { width: 2.75rem; padding: 0; }

  .nav-panel {
    padding: 0.5rem var(--pad) 1.5rem;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .nav-panel ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
  }
  .nav-panel a {
    display: flex;
    width: 100%;
    padding: 0.875rem 0;
    font-size: 0.9375rem;
    border-bottom: 1px solid rgb(var(--seam));
  }
  .nav-panel-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .nav-k { display: inline-flex; }
  }
  @media (min-width: 900px) {
    .nav-switch { display: inline-flex; }
  }
  @media (min-width: 1240px) {
    .nav-sel { display: block; margin: 0 auto; }
    .nav-mark { margin-right: 0; }
    .nav-menu, .nav-panel { display: none !important; }
  }
</style>
