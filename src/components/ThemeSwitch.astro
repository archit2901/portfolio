---
/** Two-position slide switch. State is painted by BaseLayout's theme script. */
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<button type="button" role="switch" aria-checked="false" aria-label="Dark mode" data-theme-switch class:list={['ts', cls]}>
  <span class="ts-l" aria-hidden="true">Light</span>
  <span class="ts-track" aria-hidden="true"><span class="ts-thumb"></span></span>
  <span class="ts-l" aria-hidden="true">Dark</span>
</button>

<style>
  .ts {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: rgb(var(--ink-3));
  }
  .ts-l {
    font-size: 0.6875rem;
    font-weight: 640;
    font-stretch: 78%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 160ms ease;
  }
  .ts[aria-checked='false'] .ts-l:first-child,
  .ts[aria-checked='true'] .ts-l:last-child { color: rgb(var(--ink)); }
  .ts-track {
    position: relative;
    width: 2.75rem;
    height: 1.5rem;
    border-radius: 0.75rem;
    background: rgb(var(--sunk));
    box-shadow: var(--shadow-well);
  }
  .ts-thumb {
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 1.375rem;
    height: 1.125rem;
    border-radius: 0.5625rem;
    background: rgb(var(--raised));
    box-shadow: var(--shadow-key);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ts[aria-checked='true'] .ts-thumb { transform: translateX(1rem); }
</style>
