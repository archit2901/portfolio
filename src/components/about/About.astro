---
import { profile } from '~/data/profile';
import { sectionById } from '~/data/sections';
import SectionHeading from '~/components/SectionHeading.astro';

const s = sectionById('about');
const { about } = profile;
// The fact line reads as a two-part readout, cut by a seam like the hero's.
const facts = about.factLine.split(' · ');
---

<section id={s.id} class="module" aria-labelledby={`${s.id}-title`}>
  <div class="about">
    <div class="about-main">
      <SectionHeading id={s.id} text={s.heading} />
      <p class="about-fact well figure">{facts.map((f) => <span>{f}</span>)}</p>
      <div class="about-bio justify">
        {about.bio.map((p) => <p>{p.replaceAll('Fortune 500', 'Fortune 500')}</p>)}
      </div>
    </div>

    <figure class="about-photo well">
      <img
        src={about.portrait.src}
        width={about.portrait.width}
        height={about.portrait.height}
        alt={about.portrait.alt}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <dl class="about-plate" aria-label="Quick facts">
      {about.quickFacts.map((f) => (
        <div>
          <dt class="engraved">{f.label}</dt>
          <dd>{f.value.split(' ').map((w, i) => (
            <>{i > 0 && ' '}{w.includes('-') ? <span class="nobr">{w}</span> : w}</>
          ))}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Below 1240px: copy on top, then the portrait beside the quick facts.
     From 1240px: copy and the quick-facts strip on the left, one tall
     portrait on the right sized so both columns end together. */
  .about {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    grid-template-areas:
      "main main"
      "photo facts";
    column-gap: 1rem;
    row-gap: 2.5rem;
    align-items: start;
  }
  .about-main { grid-area: main; container-type: inline-size; }
  .about-photo { grid-area: photo; }
  .about-plate { grid-area: facts; }

  /* Two lines until the column can hold both parts on one; never a
     wrapped line that starts with a seam. */
  .about-fact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: fit-content;
    max-width: 100%;
    margin: 1.75rem 0 0;
    padding: 0.875rem 1.125rem;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .about-fact span + span { color: rgb(var(--ink-2)); }
  @container (min-width: 44rem) {
    .about-fact { flex-direction: row; }
    .about-fact span { white-space: nowrap; }
    .about-fact span + span {
      margin-left: 0.875rem;
      padding-left: 0.875rem;
      border-left: 1px solid rgb(var(--seam));
      box-shadow: inset 1px 0 0 rgb(var(--seam-hi));
    }
  }

  .about-bio {
    margin-top: 1.75rem;
    max-width: 68ch;
    color: rgb(var(--ink-2));
  }
  .about-bio p { margin: 0 0 1.125rem; text-wrap: pretty; }
  .about-bio p:last-child { margin-bottom: 0; }
  .about-bio p:first-child { color: rgb(var(--ink)); }

  .about-photo {
    margin: 0;
    padding: 0.375rem;
    aspect-ratio: 3 / 4;
  }
  .about-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 0.5625rem;
  }

  .about-plate {
    margin: 0;
    display: grid;
  }
  .about-plate div {
    padding: 0.5rem 0;
    border-bottom: 1px solid rgb(var(--seam-hi));
    box-shadow: inset 0 -1px 0 rgb(var(--seam));
  }
  .about-plate div:first-child { padding-top: 0; }
  .about-plate dd {
    margin: 0.125rem 0 0;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  /* "full-time" never splits at its hyphen. */
  .nobr { white-space: nowrap; }

  @media (min-width: 640px) {
    .about { grid-template-columns: 12rem minmax(0, 1fr); column-gap: 1.25rem; }
    .about-plate { max-width: 24rem; }
    .about-plate div { padding: 0.75rem 0; }
    .about-plate div:first-child { padding-top: 0; }
    .about-plate dd { margin-top: 0.25rem; font-size: 1rem; }
  }

  @media (min-width: 1240px) {
    .about {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "main photo"
        "facts photo";
      column-gap: clamp(3rem, 6vw, 5rem);
      row-gap: 2.25rem;
    }
    /* Bottom-aligned: the portrait and the facts strip end on one line,
       and any spare height sits beside the heading, not under the bio. */
    .about-photo {
      width: min(100%, 28rem);
      justify-self: end;
      align-self: end;
    }

    /* Quick facts become one engraved readout strip under the bio. */
    .about-plate {
      align-self: end;
      max-width: none;
      display: flex;
      padding-top: 1.25rem;
      border-top: 1px solid rgb(var(--seam));
      box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
    }
    .about-plate div {
      flex: none;
      padding: 0 1.25rem;
      border-bottom: 0;
      box-shadow: none;
    }
    .about-plate div:first-child { padding-left: 0; padding-top: 0; }
    .about-plate div:last-child { flex: 0 1 auto; min-width: 0; padding-right: 0; }
    .about-plate div + div {
      border-left: 1px solid rgb(var(--seam));
      box-shadow: inset 1px 0 0 rgb(var(--seam-hi));
    }
    .about-plate dd { text-wrap: balance; }
  }
</style>
