---
/**
 * ⌘K command palette. Items are computed at build time from src/data;
 * the runtime below handles fuzzy search, keyboard nav and g-chords.
 */
import { sections } from '~/data/sections';
import { links } from '~/data/profile';

type PaletteItem =
  | { kind: 'navigate'; label: string; target: string; hint?: string; group: 'Go to' }
  | { kind: 'open'; label: string; href: string; group: 'Open' }
  | { kind: 'download'; label: string; href: string; filename: string; group: 'Open' }
  | { kind: 'copy'; label: string; text: string; group: 'Actions' }
  | { kind: 'toggle'; label: string; action: 'theme' | 'reduce-motion' | 'replay'; group: 'Actions' };

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const prefix = (anchor: string) => (isHome ? anchor : `/${anchor}`);

const items: PaletteItem[] = [
  { kind: 'navigate', group: 'Go to', label: 'Top of page', target: isHome ? '#__top' : '/', hint: 'g h' },
  ...sections.map((s): PaletteItem => ({
    kind: 'navigate',
    group: 'Go to',
    label: s.label,
    target: prefix(`#${s.id}`),
    hint: s.chord ? `g ${s.chord}` : undefined,
  })),
  { kind: 'open', group: 'Open', label: 'All projects', href: '/projects' },
  { kind: 'download', group: 'Open', label: 'Download résumé (PDF)', href: links.resume, filename: links.resumeFileName },
  { kind: 'open', group: 'Open', label: 'GitHub', href: links.github },
  { kind: 'open', group: 'Open', label: 'LinkedIn', href: links.linkedin },
  { kind: 'open', group: 'Open', label: 'Email', href: `mailto:${links.email}` },
  { kind: 'open', group: 'Open', label: 'Uses', href: '/uses' },
  { kind: 'copy', group: 'Actions', label: 'Copy email address', text: links.email },
  { kind: 'toggle', group: 'Actions', label: 'Toggle light / dark theme', action: 'theme' },
  { kind: 'toggle', group: 'Actions', label: 'Toggle reduced motion', action: 'reduce-motion' },
  { kind: 'toggle', group: 'Actions', label: 'Replay power-on', action: 'replay' },
];

const chords = Object.fromEntries(
  sections.filter((s) => s.chord).map((s) => [s.chord as string, `#${s.id}`]),
);
---

<div id="cmd-palette" role="dialog" aria-modal="true" aria-label="Command palette" data-open="false" class="cmd">
  <div class="cmd-backdrop" data-cmd-backdrop></div>
  <div class="cmd-panel">
    <div class="cmd-search well">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
      <input
        id="cmd-input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmd-results"
        aria-autocomplete="list"
        aria-label="Search sections and actions"
        placeholder="Jump to a section or run an action"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <kbd class="cmd-kbd">esc</kbd>
    </div>
    <ul id="cmd-results" class="cmd-list" role="listbox" aria-label="Results"></ul>
    <div id="cmd-empty" class="cmd-empty hidden">No matches. Try a section name.</div>
    <div class="cmd-foot engraved">
      <span><kbd class="cmd-kbd">↑</kbd><kbd class="cmd-kbd">↓</kbd> move</span>
      <span><kbd class="cmd-kbd">↵</kbd> select</span>
      <span><kbd class="cmd-kbd">g</kbd> then a letter jumps</span>
    </div>
  </div>
</div>

<style is:global>
  .cmd {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    transition: opacity 140ms ease;
  }
  .cmd[data-open='true'] { opacity: 1; pointer-events: auto; }
  .cmd-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(var(--desk) / 0.72);
    backdrop-filter: blur(3px);
  }
  .cmd-panel {
    position: absolute;
    left: 50%;
    top: 14vh;
    width: min(92vw, 36rem);
    transform: translate(-50%, 6px);
    padding: 0.75rem;
    border-radius: 1.25rem;
    background: rgb(var(--plate));
    box-shadow: var(--shadow-plate), 0 30px 60px -30px rgb(0 0 0 / 0.45);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cmd[data-open='true'] .cmd-panel { transform: translate(-50%, 0); }
  .cmd-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.875rem;
    color: rgb(var(--ink-3));
  }
  .cmd-search input {
    flex: 1;
    min-width: 0;
    height: 3rem;
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 1rem;
    color: rgb(var(--ink));
  }
  .cmd-search input::placeholder { color: rgb(var(--ink-3)); }
  .cmd-search input:focus { outline: none; }
  .cmd-search:focus-within { box-shadow: var(--shadow-well), 0 0 0 3px rgb(var(--focus)); }
  .cmd-list {
    max-height: min(52vh, 24rem);
    overflow-y: auto;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cmd-group-header {
    padding: 0.75rem 0.75rem 0.25rem;
    font-size: 0.6875rem;
    font-weight: 640;
    font-stretch: 78%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--ink-3));
  }
  .cmd-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.625rem;
    cursor: pointer;
    color: rgb(var(--ink-2));
  }
  .cmd-item[data-active='true'] {
    background: rgb(var(--raised));
    box-shadow: var(--shadow-key);
    color: rgb(var(--ink));
  }
  .cmd-item-icon { display: inline-flex; color: rgb(var(--ink-3)); }
  .cmd-item[data-active='true'] .cmd-item-icon { color: rgb(var(--ink)); }
  .cmd-item-label { flex: 1; font-size: 0.9375rem; font-weight: 560; }
  .cmd-item-hint { font-size: 0.75rem; font-weight: 600; color: rgb(var(--ink-3)); font-variant-numeric: tabular-nums; }
  .cmd-empty { padding: 1.5rem 0.75rem; text-align: center; color: rgb(var(--ink-3)); }
  .cmd-empty.hidden { display: none; }
  .cmd-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.75rem 0.75rem 0.25rem;
    margin-top: 0.5rem;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .cmd-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.375rem;
    height: 1.375rem;
    padding: 0 0.3125rem;
    margin-right: 0.25rem;
    border-radius: 0.375rem;
    background: rgb(var(--raised));
    box-shadow: var(--shadow-key);
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 640;
    color: rgb(var(--ink-2));
    text-transform: none;
    letter-spacing: 0;
  }
</style>

<script is:inline define:vars={{ items, chords }}>
  // ── Palette state + DOM refs ─────────────────────────────────────────
  const palette = document.getElementById('cmd-palette');
  const input = /** @type {HTMLInputElement | null} */ (document.getElementById('cmd-input'));
  const list = document.getElementById('cmd-results');
  const empty = document.getElementById('cmd-empty');
  const backdrop = palette?.querySelector('[data-cmd-backdrop]');

  if (palette && input && list && empty) {
    let currentItems = [];
    let activeIndex = 0;

    // ── Fuzzy match (cheap, ~30 lines): score by substring + initials ──
    function score(query, label) {
      const q = query.toLowerCase().trim();
      const l = label.toLowerCase();
      if (!q) return 1; // No query: keep everything, base score
      if (l === q) return 1000;
      if (l.startsWith(q)) return 700;
      if (l.includes(q)) return 500;
      // Initials match (e.g., "ge" matches "Get Experience")
      const initials = l.split(/[\s\-_/]+/).map((w) => w[0] || '').join('');
      if (initials.startsWith(q)) return 400;
      if (initials.includes(q)) return 200;
      // Subsequence match: every char of q appears in order in l
      let i = 0;
      for (const ch of l) { if (ch === q[i]) i++; if (i === q.length) break; }
      if (i === q.length) return 100;
      return 0;
    }

    function filterItems(query) {
      return items
        .map((it) => ({ it, s: score(query, it.label) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .map((x) => x.it);
    }

    const SVG_ATTRS = 'width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block"';
    const ICONS = {
      navigate: `<svg ${SVG_ATTRS}><path d="M9 6 15 12 9 18"/></svg>`,
      open:     `<svg ${SVG_ATTRS}><path d="M14 4 20 4 20 10"/><path d="M20 4 10 14"/><path d="M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6"/></svg>`,
      download: `<svg ${SVG_ATTRS}><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>`,
      toggle:   `<svg ${SVG_ATTRS}><rect x="3" y="8" width="18" height="8" rx="4"/><circle cx="8" cy="12" r="2"/></svg>`,
      copy:     `<svg ${SVG_ATTRS}><rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M15.5 8.5V6a1.5 1.5 0 0 0-1.5-1.5H6A1.5 1.5 0 0 0 4.5 6v8A1.5 1.5 0 0 0 6 15.5h2.5"/></svg>`,
    };

    function render(query) {
      currentItems = filterItems(query);
      list.innerHTML = '';
      if (currentItems.length === 0) {
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');

      let lastGroup = '';
      currentItems.forEach((it, idx) => {
        if (it.group !== lastGroup) {
          const h = document.createElement('li');
          h.className = 'cmd-group-header';
          h.textContent = it.group;
          h.setAttribute('aria-hidden', 'true');
          list.appendChild(h);
          lastGroup = it.group;
        }
        const li = document.createElement('li');
        li.className = 'cmd-item';
        li.setAttribute('role', 'option');
        li.dataset.index = String(idx);
        li.innerHTML = `
          <span class="cmd-item-icon">${ICONS[it.kind]}</span>
          <span class="cmd-item-label">${escapeHtml(it.label)}</span>
          ${it.hint ? `<span class="cmd-item-hint">${escapeHtml(it.hint)}</span>` : ''}
        `;
        li.addEventListener('click', () => activate(idx));
        li.addEventListener('pointerenter', () => setActive(idx));
        list.appendChild(li);
      });
      activeIndex = 0;
      paintActive();
    }

    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function paintActive() {
      const rows = list.querySelectorAll('.cmd-item');
      rows.forEach((row, i) => {
        row.setAttribute('data-active', String(i === activeIndex));
        row.setAttribute('aria-selected', String(i === activeIndex));
        row.id = 'cmd-opt-' + i;
      });
      input.setAttribute('aria-activedescendant', 'cmd-opt-' + activeIndex);
      const active = rows[activeIndex];
      if (active) active.scrollIntoView({ block: 'nearest' });
    }

    function setActive(i) {
      if (i < 0 || i >= currentItems.length) return;
      activeIndex = i;
      paintActive();
    }

    function activate(i) {
      const it = currentItems[i];
      if (!it) return;
      close();
      if (it.kind === 'navigate') {
        const t = it.target;
        if (t === '#__top') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else if (t === '/') {
          // off-home "Top of page" — navigate back to home
          window.location.href = '/';
        } else if (t.startsWith('#')) {
          const el = document.querySelector(t);
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          // /#anchor — full URL change, browser handles the scroll
          window.location.href = t;
        }
      } else if (it.kind === 'open') {
        const isExternal = /^https?:/.test(it.href);
        if (isExternal) window.open(it.href, '_blank', 'noopener,noreferrer');
        else window.location.href = it.href;
      } else if (it.kind === 'download') {
        const a = document.createElement('a');
        a.href = it.href;
        a.download = it.filename ?? '';
        document.body.appendChild(a);
        a.click();
        a.remove();
      } else if (it.kind === 'toggle' && it.action === 'replay') {
        try { sessionStorage.removeItem('powered-on'); } catch (e) {}
        window.location.href = '/';
      } else if (it.kind === 'toggle' && it.action === 'theme') {
        if (window.__toggleTheme) window.__toggleTheme();
      } else if (it.kind === 'copy') {
        if (window.__copy) window.__copy(it.text).then((ok) => window.__toast && window.__toast(ok ? 'Email address copied' : 'Copy failed'));
      } else if (it.kind === 'toggle' && it.action === 'reduce-motion') {
        const on = document.documentElement.getAttribute('data-reduce-motion') !== 'true';
        document.documentElement.setAttribute('data-reduce-motion', String(on));
        try { localStorage.setItem('pref-reduce-motion', String(on)); } catch (e) {}
      }
    }

    function open(initialQuery) {
      if (!palette) return;
      palette.dataset.open = 'true';
      input.value = initialQuery || '';
      render(input.value);
      requestAnimationFrame(() => input.focus());
      document.body.style.overflow = 'hidden';
    }

    function close() {
      if (!palette) return;
      palette.dataset.open = 'false';
      document.body.style.overflow = '';
      input.blur();
    }

    // ── Wire DOM events ───────────────────────────────────────────────
    input.addEventListener('input', () => render(input.value));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(activeIndex + 1, currentItems.length - 1)); }
      else if (e.key === 'ArrowUp')   { e.preventDefault(); setActive(Math.max(activeIndex - 1, 0)); }
      else if (e.key === 'Enter')      { e.preventDefault(); activate(activeIndex); }
      else if (e.key === 'Escape')     { e.preventDefault(); close(); }
    });
    backdrop?.addEventListener('click', close);

    // ── Public open/close API via custom events ──────────────────────
    window.addEventListener('palette:open', (e) => {
      const detail = /** @type {CustomEvent} */ (e).detail || {};
      open(detail.query);
    });
    window.addEventListener('palette:close', close);

    // ── Global key handler: ⌘K / Ctrl+K / ? / g+letter chords ────────
    let chordPending = false;
    let chordTimer = 0;

    const NAV_TARGETS = Object.assign({ h: '#__top' }, chords);

    window.addEventListener('keydown', (e) => {
      const t = e.target;
      const inField =
        t instanceof HTMLInputElement ||
        t instanceof HTMLTextAreaElement ||
        (t instanceof HTMLElement && t.isContentEditable);

      // ⌘K / Ctrl+K — always (even from input, since it should override field focus)
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (palette.dataset.open === 'true') close();
        else open();
        return;
      }

      if (inField) return;

      // ? — open palette
      if (e.key === '?') {
        e.preventDefault();
        open();
        return;
      }

      // g chord init
      if (e.key === 'g' && !e.metaKey && !e.ctrlKey && !e.altKey) {
        chordPending = true;
        clearTimeout(chordTimer);
        chordTimer = window.setTimeout(() => { chordPending = false; }, 1000);
        return;
      }

      if (chordPending) {
        chordPending = false;
        clearTimeout(chordTimer);
        const target = NAV_TARGETS[e.key.toLowerCase()];
        if (target) {
          e.preventDefault();
          const onHome = window.location.pathname === '/' || window.location.pathname === '';
          if (target === '#__top') {
            if (onHome) window.scrollTo({ top: 0, behavior: 'smooth' });
            else window.location.href = '/';
          } else if (onHome) {
            document.querySelector(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } else {
            // Off-home: jump back to the home page with the anchor
            window.location.href = `/${target}`;
          }
        }
      }
    });

    // ── Restore the toggled reduced-motion pref on load ───────────────
    try {
      const stored = localStorage.getItem('pref-reduce-motion');
      if (stored === 'true') document.documentElement.setAttribute('data-reduce-motion', 'true');
    } catch (_) {}

    // Initial render so the empty open state has the full list ready
    render('');
  }
</script>
