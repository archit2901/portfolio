---
import { profile, links } from '~/data/profile';
import { sectionById } from '~/data/sections';
import SectionHeading from '~/components/SectionHeading.astro';
import Icon from '~/components/Icon.astro';

const s = sectionById('contact');
const { contact } = profile;
---

<section id={s.id} class="module" aria-labelledby={`${s.id}-title`}>
  <div class="ct">
    <div class="ct-copy">
      <SectionHeading id={s.id} text={s.heading} />
      <p class="ct-lead">{contact.lead}</p>
      <ul class="ct-status">
        {contact.status.map((st, i) => (
          <li class:list={[{ 'ct-now': i === contact.status.length - 1 }]}>
            <span class:list={['led', { 'led-on': i === contact.status.length - 1 }]} aria-hidden="true"></span>{st}
          </li>
        ))}
      </ul>
    </div>

    <div class="ct-panel">
      <div class="ct-email well">
        <span class="engraved">Email</span>
        <a class="ct-addr" href={`mailto:${links.email}`}>{links.email}</a>
        <div class="ct-email-keys">
          <button type="button" class="key key-dark" data-copy-email={links.email}>
            <span class="ct-ico-copy"><Icon name="copy" size={16} /></span>
            <span class="ct-ico-done"><Icon name="check" size={16} /></span>
            <span data-copy-label>Copy address</span>
          </button>
          <a class="key" href={`mailto:${links.email}`}><Icon name="mail" size={16} />Write an email</a>
        </div>
      </div>
      <div class="ct-keys">
        <a class="key" href={links.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} />GitHub</a>
        <a class="key" href={links.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={15} />LinkedIn</a>
        <a class="key key-accent" href={links.resume} download={links.resumeFileName}><Icon name="download" size={16} />Download résumé</a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-copy-email]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const addr = btn.getAttribute('data-copy-email') || '';
        const ok = window.__copy ? await window.__copy(addr) : false;
        const label = btn.querySelector('[data-copy-label]');
        btn.setAttribute('aria-pressed', 'true');
        btn.classList.add('is-done');
        if (label) label.textContent = ok ? 'Copied' : 'Press ⌘C';
        window.__toast && window.__toast(ok ? 'Email address copied' : 'Copy failed: select the address');
        setTimeout(() => {
          btn.removeAttribute('aria-pressed');
          btn.classList.remove('is-done');
          if (label) label.textContent = 'Copy address';
        }, 1800);
      });
    });
  })();
</script>

<style>
  .ct {
    display: grid;
    gap: 2.5rem;
  }
  .ct-lead {
    margin: 1.25rem 0 0;
    max-width: 44ch;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: rgb(var(--ink-2));
  }
  .ct-status {
    display: grid;
    gap: 0.625rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    font-weight: 560;
    color: rgb(var(--ink-2));
  }
  .ct-status li { display: flex; align-items: center; gap: 0.75rem; }
  .ct-now { color: rgb(var(--ink)); font-weight: 640; }

  .ct-email {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border-radius: 1rem;
  }
  .ct-addr {
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 680;
    letter-spacing: -0.015em;
    color: rgb(var(--ink));
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .ct-addr:hover { text-decoration: underline; text-decoration-color: rgb(var(--ink-3)); text-decoration-thickness: 2px; }
  .ct-email-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.25rem;
  }
  .ct-ico-done { display: none; }
  .is-done .ct-ico-copy { display: none; }
  .is-done .ct-ico-done { display: inline-flex; }
  .ct-keys {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .ct-keys .key { min-height: 3.25rem; }
  .ct-keys .key-accent { grid-column: 1 / -1; }

  @media (min-width: 640px) {
    .ct-keys { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ct-keys .key-accent { grid-column: auto; }
  }
  @media (min-width: 1024px) {
    .ct {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
  }
</style>
