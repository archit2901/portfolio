---
import { education } from '~/data/education';
import { sectionById } from '~/data/sections';
import SectionHeading from '~/components/SectionHeading.astro';

const s = sectionById('education');
---

<section id={s.id} class="module" aria-labelledby={`${s.id}-title`}>
  <SectionHeading id={s.id} text={s.heading} />

  <ol class="ed">
    {education.map((e) => (
      <li class="ed-row cut-md">
        <div class="ed-meta">
          <p class="ed-when figure">{e.start} – {e.end}</p>
          <p class="ed-where">{e.location}</p>
        </div>
        <div class="ed-body">
          <h3 class="ed-school">{e.school}</h3>
          <p class="ed-degree">{e.degree}{e.department && <span class="ed-dept">{e.department}</span>}</p>
          {e.gpa && (
            <p class="ed-gpa well figure"><span class="engraved">GPA</span>{e.gpa}</p>
          )}
          <p class="engraved ed-cw-label">Coursework</p>
          <ul class="ed-cw">
            {e.coursework.map((c) => (
              <li>{c.code && <span class="ed-code figure">{c.code}</span>}{c.title}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .ed {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .ed-row {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 0;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .ed-row:last-child { padding-bottom: 0; }
  .ed-meta p { margin: 0; }
  .ed-when { font-weight: 640; font-size: 0.9375rem; }
  .ed-where { margin-top: 0.125rem !important; font-size: 0.875rem; color: rgb(var(--ink-3)); }
  .ed-school {
    margin: 0;
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.018em;
    line-height: 1.2;
  }
  .ed-degree {
    margin: 0.25rem 0 0;
    font-size: 1.0625rem;
    font-weight: 540;
    color: rgb(var(--ink-2));
  }
  .ed-dept { display: block; font-size: 0.9375rem; color: rgb(var(--ink-3)); }
  .ed-gpa {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0.5rem 0.875rem;
    border-radius: 0.625rem;
    font-weight: 700;
    font-size: 1.125rem;
  }
  .ed-cw-label { margin: 1.5rem 0 0.5rem; }
  .ed-cw {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 48rem;
  }
  .ed-cw li {
    display: flex;
    gap: 0.875rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgb(var(--seam) / 0.7);
    font-weight: 540;
  }
  .ed-code {
    min-width: 4rem;
    font-weight: 640;
    font-size: 0.875rem;
    color: rgb(var(--ink-3));
    padding-top: 0.1em;
  }

  @media (min-width: 768px) {
    .ed-row {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 2.5rem;
      padding: 2.5rem 0;
    }
    .ed-cw { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  }
</style>
