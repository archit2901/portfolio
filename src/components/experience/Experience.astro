---
/**
 * Roles as faceplate rows. Bullets carry an indicator LED; a bullet that an
 * impact stat points at lights up when it is the URL target (:target).
 */
import { experience, visibleBullets, bulletAnchor } from '~/data/experience';
import { sectionById } from '~/data/sections';
import SectionHeading from '~/components/SectionHeading.astro';

const s = sectionById('experience');
---

<section id={s.id} class="module" aria-labelledby={`${s.id}-title`}>
  <SectionHeading id={s.id} text={s.heading} />

  <ol class="xp">
    {experience.map((r) => {
      const all = r.bullets.map((b, i) => ({ ...b, id: bulletAnchor(r, i) }));
      const shown = all.slice(0, visibleBullets);
      const extra = all.slice(visibleBullets);
      return (
        <li class="xp-role cut-md" id={`role-${r.slug}`}>
          <div class="xp-meta">
            <p class="xp-when figure">
              {r.current && <span class="led led-on" aria-hidden="true"></span>}
              <span>{r.start} – {r.end}</span>
            </p>
            <p class="xp-where">{r.location}</p>
          </div>

          <div class="xp-body">
            <h3 class="xp-title">{r.role}</h3>
            <p class="xp-company">{r.company}{r.current && <span class="sr-only"> (current role)</span>}</p>
            {r.highlight && <p class="xp-high well figure">{r.highlight}</p>}

            <ul class="xp-bullets justify">
              {shown.map((b) => <li id={b.id}><span class="led" aria-hidden="true"></span><span>{b.text}</span></li>)}
            </ul>
            {extra.length > 0 && (
              <details class="xp-more">
                <summary class="key">
                  <span class="xp-more-closed">{extra.length} more</span>
                  <span class="xp-more-open">Show fewer</span>
                </summary>
                <ul class="xp-bullets justify">
                  {extra.map((b) => <li id={b.id}><span class="led" aria-hidden="true"></span><span>{b.text}</span></li>)}
                </ul>
              </details>
            )}

            {r.stack.length > 0 && (
              <ul class="tags xp-tags" aria-label="Technologies">
                {r.stack.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </div>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .xp {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .xp-role {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 0;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .xp-role:last-child { padding-bottom: 0; }
  .xp-meta p { margin: 0; }
  .xp-when {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 640;
    font-size: 0.9375rem;
  }
  .xp-where {
    margin-top: 0.125rem !important;
    font-size: 0.875rem;
    color: rgb(var(--ink-3));
  }
  .xp-title {
    margin: 0;
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.018em;
    line-height: 1.2;
  }
  .xp-company {
    margin: 0.25rem 0 0;
    font-size: 1.0625rem;
    font-weight: 540;
    color: rgb(var(--ink-2));
  }
  .xp-high {
    display: inline-block;
    margin: 1rem 0 0;
    padding: 0.5rem 0.875rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 620;
  }
  .xp-bullets {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    max-width: 72ch;
  }
  /* Wide screens: the bullets fill the body column out to the row's right
     seam, set as justified blocks. */
  @media (min-width: 1024px) {
    .xp-bullets { max-width: none; }
  }
  .xp-bullets li {
    display: flex;
    gap: 0.875rem;
    margin: 0 -0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.625rem;
    color: rgb(var(--ink-2));
    line-height: 1.55;
  }
  .xp-bullets li .led { margin-top: 0.6em; }
  .xp-bullets li > span:last-child { flex: 1; min-width: 0; }
  /* Lit by a stat key (:target) or by the skills spotlight (.is-lit). */
  .xp-bullets li.is-lit {
    background: rgb(var(--sunk));
    box-shadow: var(--shadow-well);
    color: rgb(var(--ink));
  }
  .xp-bullets li.is-lit .led {
    background: rgb(var(--accent));
    box-shadow: inset 0 -1px 1px rgb(0 0 0 / 0.18), inset 0 1px 1px rgb(255 255 255 / 0.45);
  }
  .xp-bullets li:target {
    background: rgb(var(--sunk));
    box-shadow: var(--shadow-well);
    color: rgb(var(--ink));
    animation: lit 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .xp-bullets li:target .led {
    background: rgb(var(--accent));
    box-shadow: inset 0 -1px 1px rgb(0 0 0 / 0.18), inset 0 1px 1px rgb(255 255 255 / 0.45);
  }
  @keyframes lit {
    0% { background: rgb(var(--accent) / 0.22); }
    100% { background: rgb(var(--sunk)); }
  }

  .xp-more { margin-top: 0.5rem; }
  .xp-more summary {
    list-style: none;
    cursor: pointer;
    min-height: 2.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
  }
  .xp-more summary::-webkit-details-marker { display: none; }
  .xp-more-open { display: none; }
  .xp-more[open] .xp-more-open { display: inline; }
  .xp-more[open] .xp-more-closed { display: none; }
  .xp-more[open] .xp-bullets { margin-top: 0.25rem; }

  .xp-tags { margin-top: 1.25rem; }

  @media (min-width: 768px) {
    .xp-role {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 2.5rem;
      padding: 2.5rem 0;
    }
    /* Long roles: the dates ride along under the nav instead of leaving
       the label column empty while the bullets scroll past. */
    .xp-meta {
      position: sticky;
      top: calc(var(--nav-h) + 1.5rem);
      align-self: start;
    }
  }
</style>
