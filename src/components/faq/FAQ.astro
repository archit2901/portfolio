---
import { site } from '~/content/site';
import AnchorLink from '~/components/AnchorLink.astro';

const { faq } = site;

const ACCENT_DOT: Record<string, string> = {
  cyan:   'bg-cyan-400',
  amber:  'bg-amber-400',
  rose:   'bg-rose-400',
  violet: 'bg-violet-400',
};
const ACCENT_HOVER: Record<string, string> = {
  cyan:   'group-hover:text-cyan-300',
  amber:  'group-hover:text-amber-300',
  rose:   'group-hover:text-rose-300',
  violet: 'group-hover:text-violet-300',
};
const ACCENT_BORDER: Record<string, string> = {
  cyan:   'hover:border-cyan-400/40',
  amber:  'hover:border-amber-400/40',
  rose:   'hover:border-rose-400/40',
  violet: 'hover:border-violet-400/40',
};

const pad2 = (n: number) => String(n).padStart(2, '0');
---

<section
  id="faq"
  data-visible="false"
  class="faq-section relative isolate overflow-hidden border-t border-border-subtle/40 px-5 sm:px-8 py-16 sm:py-24 md:py-32 mx-auto w-full max-w-container"
>
  {/* Atmospheric backdrop */}
  <div class="faq-grid" aria-hidden="true"></div>
  <div class="faq-blob" aria-hidden="true"></div>

  {/* Section label */}
  <p
    data-reveal="0"
    class="reveal font-mono text-xs text-text-faint tracking-wider mb-4"
  >
    <span class="text-accent/80">{faq.sectionLabel.split('·')[0].trim()}</span>
    <span class="mx-1.5 text-text-faint/70">·</span>
    <span>{faq.sectionLabel.split('·')[1]?.trim() ?? 'FAQ'}</span>
  </p>

  {/* Display heading + underline */}
  <h2
    data-reveal="1"
    class="reveal text-text-primary font-semibold tracking-tight text-4xl md:text-5xl lg:text-6xl leading-[1.05]"
  >
    <span>{faq.heading}</span>
    <AnchorLink for="faq" />
  </h2>
  <span data-reveal="2" class="reveal faq-underline" aria-hidden="true"></span>

  {/* Status banner */}
  {faq.status && (
    <p
      data-reveal="3"
      class="reveal mt-8 inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-accent/30 bg-accent/[0.05] font-mono text-[12.5px] text-accent"
    >
      <span class="block w-2 h-2 rounded-full bg-accent wordmark-dot" aria-hidden="true"></span>
      <span>{faq.status}</span>
    </p>
  )}

  {/* Q&A list — native <details> accordion */}
  <ul data-reveal="4" class="reveal mt-10 md:mt-12 list-none p-0 space-y-3">
    {
      faq.items.map((item, i) => (
        <li>
          <details
            class={`faq-card group rounded-xl bg-bg-subtle/55 backdrop-blur-sm border border-border-subtle transition-[border-color,box-shadow] duration-300 ${ACCENT_BORDER[item.accent]}`}
          >
            <summary
              class="faq-summary flex items-center gap-3 cursor-pointer select-none px-5 py-4 list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-base rounded-xl"
            >
              {/* Number */}
              <span class="font-mono text-[10px] tabular-nums uppercase tracking-[0.18em] text-text-faint shrink-0">
                {pad2(i + 1)}
              </span>

              {/* Accent dot */}
              <span class={`block w-1.5 h-1.5 rounded-full ${ACCENT_DOT[item.accent]} shrink-0`} aria-hidden="true"></span>

              {/* Question */}
              <span class={`flex-1 text-[14.5px] md:text-[15px] text-text-primary font-medium transition-colors ${ACCENT_HOVER[item.accent]}`}>
                {item.q}
              </span>

              {/* Chevron — rotates 180° via CSS sibling selector */}
              <svg
                class="faq-chevron text-text-faint shrink-0 transition-transform duration-300"
                width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true"
                style="display:block"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>

            {/* Answer */}
            <div class="faq-answer px-5 pb-5 pt-1 pl-[3.25rem]">
              <p
                class="text-[13.5px] md:text-[14px] text-text-muted leading-relaxed max-w-[68ch]"
                set:html={item.a}
              ></p>
            </div>
          </details>
        </li>
      ))
    }
  </ul>

  {/* Footer CTA */}
  {faq.footer && (
    <p
      data-reveal="5"
      class="reveal mt-10 font-mono text-[12.5px] text-text-faint"
    >
      <span>{faq.footer.prompt}</span>
      <a
        href={faq.footer.href}
        class="ml-2 inline-flex items-center gap-1 text-text-muted hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-base rounded-sm"
      >
        <span aria-hidden="true">→</span>
        <span>{faq.footer.label}</span>
      </a>
    </p>
  )}
</section>

<style>
  /* ── Atmospheric backdrop (bottom-right blob — fresh corner) ─── */
  .faq-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(34, 211, 238, 0.10) 1px, transparent 0);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 50%, #000 25%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 50%, #000 25%, transparent 80%);
  }
  .faq-blob {
    position: absolute;
    z-index: -1;
    bottom: -140px;
    right: -120px;
    width: 540px;
    height: 540px;
    border-radius: 9999px;
    background: conic-gradient(from 140deg, rgba(34,211,238,0.18), rgba(168,85,247,0.18), rgba(244,63,94,0.12), rgba(34,211,238,0.18));
    filter: blur(60px);
    opacity: 0.5;
    pointer-events: none;
  }

  /* Heading underline */
  .faq-underline {
    display: block;
    margin-top: 18px;
    height: 2px;
    width: 0;
    border-radius: 2px;
    background: linear-gradient(90deg, #22d3ee, #a855f7);
    transition: width 900ms cubic-bezier(0.22, 1, 0.36, 1) 300ms;
    will-change: width;
  }
  .faq-section[data-visible='true'] .faq-underline { width: 120px; }

  /* Reveal cascade */
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq-section[data-visible='true'] .reveal { opacity: 1; transform: translateY(0); }
  .faq-section[data-visible='true'] .reveal[data-reveal='0'] { transition-delay:   0ms; }
  .faq-section[data-visible='true'] .reveal[data-reveal='1'] { transition-delay:  90ms; }
  .faq-section[data-visible='true'] .reveal[data-reveal='2'] { transition-delay: 160ms; }
  .faq-section[data-visible='true'] .reveal[data-reveal='3'] { transition-delay: 240ms; }
  .faq-section[data-visible='true'] .reveal[data-reveal='4'] { transition-delay: 340ms; }
  .faq-section[data-visible='true'] .reveal[data-reveal='5'] { transition-delay: 460ms; }

  /* ── Accordion: chevron rotation + open-state polish ────────── */
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary { list-style: none; }

  .faq-card[open] .faq-chevron {
    transform: rotate(180deg);
    color: #67e8f9;
  }
  .faq-card[open] {
    box-shadow: inset 0 -2px 0 rgba(34, 211, 238, 0.5);
  }

  /* Smooth height transition on the answer block. Modern browsers honour
     `interpolate-size: allow-keywords` for `auto` height transitions. */
  @supports (interpolate-size: allow-keywords) {
    :root { interpolate-size: allow-keywords; }
    .faq-answer {
      block-size: 0;
      overflow: hidden;
      transition: block-size 320ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .faq-card[open] .faq-answer { block-size: auto; }
  }

  /* Inline answer links pick up the accent */
  :global(.faq-link) {
    color: #67e8f9;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 180ms ease;
  }
  :global(.faq-link:hover) { color: #22d3ee; }

  /* Breathing dot reuse */
  .wordmark-dot {
    animation: dot-breathe 2.4s ease-in-out infinite;
  }
  @keyframes dot-breathe {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.15); }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .faq-underline { width: 120px; transition: none; }
    .faq-chevron { transition: none; }
    .faq-answer { transition: none !important; }
    .wordmark-dot { animation: none; opacity: 1; transform: none; }
    .faq-grid, .faq-blob { transform: none !important; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('section#faq.faq-section');
  if (section) {
    // Section reveal
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).dataset.visible = 'true';
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -15% 0px', threshold: 0.1 }
    );
    io.observe(section);

    // Parallax on backdrop (grid up, blob down)
    const grid = section.querySelector<HTMLElement>('.faq-grid');
    const blob = section.querySelector<HTMLElement>('.faq-blob');
    if ((grid || blob) && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      let raf = 0;
      const onScroll = () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const rect = section.getBoundingClientRect();
          const vh = window.innerHeight || 1;
          const progress = (vh - rect.top) / (vh + rect.height);
          const clamped = Math.max(-0.5, Math.min(1.5, progress));
          if (grid) grid.style.transform = `translateY(${(-clamped * 40).toFixed(1)}px)`;
          if (blob) blob.style.transform = `translateY(${(clamped * 25).toFixed(1)}px)`;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }
</script>
