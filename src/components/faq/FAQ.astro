---
import { faq, faqBanner } from '~/data/faq';
import { sectionById } from '~/data/sections';
import SectionHeading from '~/components/SectionHeading.astro';
import Icon from '~/components/Icon.astro';

const s = sectionById('faq');
---

<section id={s.id} class="module" aria-labelledby={`${s.id}-title`}>
  <div class="fq-head">
    <SectionHeading id={s.id} text={s.heading} />
    <p class="fq-banner well"><span class="led led-on" aria-hidden="true"></span>{faqBanner}</p>
  </div>

  <div class="fq-list">
    {faq.map((item, i) => (
      <details class="fq" open={i < 2}>
        <summary>
          <span class="fq-q">{item.q}</span>
          <span class="fq-k" aria-hidden="true"><Icon name="plus" size={16} /></span>
        </summary>
        <div class="fq-a justify" set:html={item.a} />
      </details>
    ))}
  </div>
</section>

<style>
  .fq-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .fq-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.75rem 1.125rem;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .fq-list {
    margin-top: 2.5rem;
    /* Seam drawn inside the box so its edges never alias into a line. */
    border-bottom: 1px solid rgb(var(--seam-hi));
    box-shadow: inset 0 -1px 0 rgb(var(--seam));
  }
  .fq {
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .fq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }
  .fq summary::-webkit-details-marker { display: none; }
  .fq-q {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    font-weight: 640;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .fq-k {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    background: rgb(var(--raised));
    box-shadow: var(--shadow-key);
    transition: box-shadow 120ms ease;
  }
  .fq-k :global(svg) { transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  .fq[open] .fq-k { box-shadow: var(--shadow-key-down); }
  .fq[open] .fq-k :global(svg) { transform: rotate(45deg); }
  .fq summary:hover .fq-q { color: rgb(var(--ink)); }
  .fq-a {
    padding: 0 3.75rem 1.5rem 0;
    max-width: 72ch;
    color: rgb(var(--ink-2));
  }
  .fq-a :global(strong) { color: rgb(var(--ink)); font-weight: 640; }
  .fq-a :global(a) {
    color: rgb(var(--ink));
    text-decoration: underline;
    text-decoration-color: rgb(var(--ink-3));
    text-decoration-thickness: 2px;
  }
  @media (max-width: 639px) {
    .fq-a { padding-right: 0; }
  }
</style>
