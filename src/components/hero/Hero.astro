---
/**
 * First viewport: the control module of the faceplate.
 *   Left:  name, role, tagline, status readout, primary keys, profile keys.
 *   Right: a large 3:4 portrait window with a speaker grille strip.
 *   Below: the metrics readout strip, cut off by an engraved seam.
 * The portrait swaps to a graphite-backdrop variant in dark mode.
 */
import { profile, links } from '~/data/profile';
import { stats } from '~/data/stats';
import Icon from '~/components/Icon.astro';

const { hero, about } = profile;
const shot = about.headshot;
const facts = hero.status.slice(0, -1);
const live = hero.status[hero.status.length - 1];
// Orange key leads the primary row.
const ctas = [...hero.ctas].sort((a, b) => Number(b.kind === 'download') - Number(a.kind === 'download'));
const sizes = '(min-width: 1280px) 340px, (min-width: 1024px) 26vw, (min-width: 640px) 160px, 128px';
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero-copy">
    <h1 id="hero-name" class="hero-h1">
      <span class="hero-greet">{hero.eyebrow}</span>
      <span class="hero-name">{hero.name}</span>
    </h1>
    <p class="hero-role">{hero.role}</p>
    <p class="hero-tag">{hero.tagline}</p>

    <div class="hero-readout well figure" role="group" aria-label="Status">
      <p class="ro-facts">{facts.map((f) => <span>{f}</span>)}</p>
      <p class="ro-live"><span class="led led-on" aria-hidden="true"></span>{live}</p>
    </div>

    <div class="hero-actions">
      {ctas.map((c) =>
        c.kind === 'download' ? (
          <a class="key key-accent hero-act" href={c.href} download={links.resumeFileName}>
            <Icon name="download" size={18} />{c.label}
          </a>
        ) : (
          <a class="key key-dark hero-act" href={c.href}>{c.label}</a>
        ),
      )}
    </div>

    <ul class="hero-links" aria-label="Profiles">
      <li><a class="key" href={links.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} />GitHub</a></li>
      <li><a class="key" href={links.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={15} />LinkedIn</a></li>
      <li><a class="key" href={`mailto:${links.email}`}><Icon name="mail" size={16} />Email</a></li>
    </ul>
  </div>

  <div class="hero-panel">
    <figure class="hero-window">
      <div class="hero-shot well">
        <img
          class="shot-light"
          src={shot.src}
          srcset={`${shot.srcSmall} 375w, ${shot.src} 750w`}
          sizes={sizes}
          width={shot.width}
          height={shot.height}
          alt={shot.alt}
          fetchpriority="high"
          decoding="async"
        />
        <img
          class="shot-dark"
          src={shot.srcDark}
          srcset={`${shot.srcDarkSmall} 375w, ${shot.srcDark} 750w`}
          sizes={sizes}
          width={shot.width}
          height={shot.height}
          alt={shot.alt}
          decoding="async"
        />
      </div>
      <div class="hero-grille" aria-hidden="true"></div>
    </figure>
  </div>

  <ul class="hero-metrics" aria-label="At a glance">
    {stats.map((s) => (
      <li>
        <a class="metric" href={s.href} data-xref={s.href.startsWith('#') ? '' : undefined}>
          <span class="metric-v figure">
            <span class="sr-only">{s.value}{s.unit ? ` ${s.unit}` : ''}</span>
            <span class="odo" aria-hidden="true" data-odo={s.value}>{s.value}</span>
            {s.unit && <span class="metric-u" aria-hidden="true">{s.unit}</span>}
          </span>
          <span class="metric-l">{s.label}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const calm = () => root.dataset.reduceMotion === 'true' || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const strip = document.querySelector('.hero-metrics');
    const odos = Array.from(document.querySelectorAll('.odo[data-odo]'));
    if (!strip || !odos.length || calm() || !('IntersectionObserver' in window)) return;

    // Each digit becomes a mechanical wheel parked at 0; other glyphs stay put.
    odos.forEach((el) => {
      const value = el.getAttribute('data-odo') || '';
      el.textContent = '';
      let n = 0;
      for (const ch of value) {
        if (/[0-9]/.test(ch)) {
          const wheel = document.createElement('span');
          wheel.className = 'odo-w';
          const band = document.createElement('span');
          band.className = 'odo-band';
          for (let k = 0; k < 20; k++) {
            const d = document.createElement('span');
            d.textContent = String(k % 10);
            band.appendChild(d);
          }
          band.dataset.to = String(10 + Number(ch));
          band.dataset.i = String(n++);
          wheel.appendChild(band);
          el.appendChild(wheel);
        } else {
          const g = document.createElement('span');
          g.className = 'odo-g';
          g.textContent = ch;
          el.appendChild(g);
        }
      }
      el.dataset.digits = String(n);
    });

    const roll = () => {
      const delay = root.classList.contains('boot') ? 650 : 0;
      odos.forEach((el, m) => {
        const bands = Array.from(el.querySelectorAll('.odo-band'));
        const total = bands.length;
        bands.forEach((b) => {
          const i = Number(b.dataset.i);
          // Rightmost wheel settles last, like a counter turning over.
          const dur = 900 + (i + 1) * 140 + (total - 1 - i) * 0;
          b.animate(
            [{ transform: 'translateY(0)' }, { transform: `translateY(-${b.dataset.to}em)` }],
            { duration: dur + i * 60, delay: delay + m * 70, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' },
          );
        });
      });
    };

    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { roll(); io.disconnect(); }
    }, { threshold: 0.35 });
    io.observe(strip);
  })();
</script>

<style>
  .hero {
    --hero-pt: clamp(2rem, 4.5vw, 3.75rem);
    --hero-pb: clamp(2rem, 3.5vw, 3rem);
    --hero-gap: clamp(2.5rem, 5vw, 4.5rem);
    --hero-rgap: clamp(2rem, 3.5vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    padding: var(--hero-pt) var(--pad) var(--hero-pb);
  }
  /* Small screens: one grid, portrait beside the name. */
  .hero-copy, .hero-panel { display: contents; }
  .hero-h1 { grid-column: 1; grid-row: 1; align-self: end; }
  .hero-window { grid-column: 2; grid-row: 1; align-self: end; }
  .hero-role, .hero-tag, .hero-readout, .hero-actions, .hero-links, .hero-metrics { grid-column: 1 / -1; }

  .hero-h1 {
    margin: 0;
    font-weight: 760;
    font-stretch: 106%;
    letter-spacing: -0.035em;
    line-height: 0.92;
    color: rgb(var(--ink));
  }
  .hero-greet {
    display: block;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-weight: 560;
    font-stretch: 100%;
    letter-spacing: -0.005em;
    line-height: 1.2;
    color: rgb(var(--ink-2));
    margin-bottom: 0.75rem;
  }
  .hero-name {
    display: block;
    font-size: clamp(3.25rem, 7.6vw, 6rem);
  }
  .hero-role {
    margin: 1.25rem 0 0;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .hero-tag {
    margin: 1rem 0 0;
    max-width: 36em;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.55;
    color: rgb(var(--ink-2));
  }

  .hero-readout {
    display: grid;
    gap: 0.375rem;
    justify-self: start;
    width: fit-content;
    max-width: 100%;
    margin: 1.5rem 0 0;
    padding: 0.875rem 1.125rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .hero-readout p { margin: 0; }
  .ro-facts {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-left: 1.25rem;
    color: rgb(var(--ink-2));
  }
  .ro-live {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgb(var(--ink));
  }

  .hero-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero-act {
    min-height: 3.5rem;
    white-space: nowrap;
    padding-inline: 1rem;
    border-radius: 0.875rem;
    font-size: 1rem;
  }
  .hero-act.key-accent { grid-column: 1 / -1; }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0.875rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-window {
    display: flex;
    gap: 0.75rem;
    margin: 0;
  }
  .hero-shot {
    position: relative;
    flex: none;
    width: 8rem;
    aspect-ratio: 3 / 4;
    padding: 0.375rem;
    border-radius: 1rem;
  }
  .hero-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.6875rem;
  }
  .shot-dark { display: none !important; }
  :global([data-theme='dark']) .shot-light { display: none !important; }
  :global([data-theme='dark']) .shot-dark { display: block !important; }
  .hero-grille {
    display: none;
    width: 3.5rem;
    border-radius: 1rem;
    background-image: radial-gradient(circle, rgb(var(--grille)) 2.1px, transparent 2.6px);
    background-size: 14px 14px;
    background-position: center top;
  }

  /* Metrics readout strip, cut from the module above by a seam. */
  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: var(--hero-rgap) 0 0;
    padding: var(--hero-rgap) 0 0;
    list-style: none;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .metric {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.625rem;
    height: 100%;
    min-height: 6.5rem;
    padding: 1rem 1rem 0.9375rem;
    border-radius: 0.875rem;
    background: rgb(var(--raised));
    box-shadow: var(--shadow-key);
    color: rgb(var(--ink));
    text-decoration: none;
    transition: transform 120ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 120ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .metric:hover { box-shadow: var(--shadow-key), 0 0 0 1px rgb(var(--seam)); }
  .metric:active { transform: translateY(1px); box-shadow: var(--shadow-key-down); }
  .metric-v {
    display: flex;
    align-items: flex-end;
    gap: 0.25rem;
    font-size: clamp(1.875rem, 2.6vw, 2.375rem);
    font-weight: 740;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .metric-u {
    line-height: 1;
    padding-bottom: 0.42em;
    font-size: 0.5em;
    font-weight: 600;
    letter-spacing: 0;
    color: rgb(var(--ink-3));
  }
  .metric-l {
    font-size: 0.875rem;
    line-height: 1.3;
    color: rgb(var(--ink-2));
  }

  /* Odometer wheels: tabular digits, 1em windows, no layout shift. */
  /* Wheels are built by script, so their styles must be global (scoped attrs aren't on them). */
  .odo { display: inline-flex; height: 1em; line-height: 1; overflow: hidden; }
  .odo :global(.odo-w) { display: block; height: 1em; overflow: hidden; }
  .odo :global(.odo-band) { display: flex; flex-direction: column; }
  .odo :global(.odo-band > span),
  .odo :global(.odo-g) { display: block; height: 1em; line-height: 1; }

  /* The metrics seam is drawn by a pseudo-element so it can be engraved on power-on. */
  .hero-metrics { position: relative; border-top: 0; box-shadow: none; }
  .hero-metrics::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: rgb(var(--seam));
    box-shadow: 0 1px 0 rgb(var(--seam-hi));
    transform-origin: left center;
  }

  /* Glass glint across the portrait window: on power-on, then on hover. */
  .hero-shot { overflow: hidden; }
  .hero-shot::after {
    content: '';
    position: absolute;
    inset: 0.375rem;
    border-radius: 0.6875rem;
    background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.32) 50%, transparent 62%);
    transform: translateX(-130%);
    opacity: 0;
    pointer-events: none;
  }
  :global([data-theme='dark']) .hero-shot::after {
    background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.1) 50%, transparent 62%);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-shot:hover::after {
      transform: translateX(130%);
      opacity: 1;
      transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  /* ── Power-on: once per session on the home page (html.boot set in <head>). ── */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.boot) .hero-panel::before { animation: seam-y 800ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    :global(html.boot) .hero-metrics::before { animation: seam-x 900ms 200ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    :global(html.boot) .hero-shot img { animation: shutter 760ms 120ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    :global(html.boot) .hero-shot::after { animation: glint 1000ms 820ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    :global(html.boot) .ro-live .led-on { animation: led-power 700ms 260ms linear both; }
    :global(html.boot) .hero-readout p { animation: warm 600ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    :global(html.boot) .ro-facts { animation-delay: 380ms; }
    :global(html.boot) .ro-live { animation-delay: 520ms; }
    :global(html.boot) .hero-act { animation: key-up 420ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    :global(html.boot) .hero-act:nth-child(1) { animation-delay: 560ms; }
    :global(html.boot) .hero-act:nth-child(2) { animation-delay: 620ms; }
    :global(html.boot) .hero-act:nth-child(3) { animation-delay: 680ms; }
    :global(html.boot) .hero-links .key { animation: key-up 420ms 740ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  }
  @keyframes seam-y { from { transform: scaleY(0); transform-origin: top; } to { transform: scaleY(1); transform-origin: top; } }
  @keyframes seam-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes shutter {
    from { clip-path: inset(48% 0 48% 0 round 0.6875rem); filter: brightness(0.7); }
    to { clip-path: inset(0 0 0 0 round 0.6875rem); filter: brightness(1); }
  }
  @keyframes glint {
    0% { transform: translateX(-130%); opacity: 1; }
    100% { transform: translateX(130%); opacity: 1; }
  }
  @keyframes led-power {
    0% { background: rgb(var(--led-off)); }
    18% { background: rgb(var(--accent)); }
    30% { background: rgb(var(--led-off)); }
    46% { background: rgb(var(--accent)); }
    58% { background: rgb(var(--led-off) / 0.6); }
    100% { background: rgb(var(--accent)); }
  }
  @keyframes warm {
    from { opacity: 0; filter: blur(3px); letter-spacing: 0.06em; }
    to { opacity: 1; filter: blur(0); letter-spacing: normal; }
  }
  @keyframes key-up {
    from { transform: translateY(3px); box-shadow: var(--shadow-key-down); opacity: 0.4; }
    to { transform: translateY(0); opacity: 1; }
  }

  @media (min-width: 640px) {
    .hero-shot { width: 10rem; }
    .hero-actions { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1fr); }
    .hero-act.key-accent { grid-column: auto; }
    .hero-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ro-facts { flex-direction: row; gap: 0; }
    .ro-facts span { white-space: nowrap; }
    .ro-facts span + span {
      margin-left: 0.875rem;
      padding-left: 0.875rem;
      border-left: 1px solid rgb(var(--seam));
      box-shadow: inset 1px 0 0 rgb(var(--seam-hi));
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      column-gap: var(--hero-gap);
      align-items: stretch;
    }
    .hero-copy, .hero-panel { display: flex; flex-direction: column; }
    .hero-copy { grid-column: 1; grid-row: 1; justify-content: center; }
    .hero-panel {
      grid-column: 2;
      grid-row: 1;
      position: relative;
      justify-content: center;
    }
    .hero-panel::before {
      content: '';
      position: absolute;
      top: calc(-1 * var(--hero-pt));
      bottom: calc(-1 * var(--hero-rgap));
      left: calc(var(--hero-gap) / -2);
      width: 1px;
      background: rgb(var(--seam));
      box-shadow: 1px 0 0 rgb(var(--seam-hi));
    }
    .hero-h1, .hero-window, .hero-role, .hero-tag, .hero-readout, .hero-actions, .hero-links {
      grid-column: auto;
      grid-row: auto;
    }
    .hero-metrics { grid-row: 2; grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .hero-h1 { align-self: stretch; }
    .hero-window { align-self: stretch; }
    .hero-shot { flex: 1; width: auto; max-width: 21.25rem; }
    .hero-grille { display: block; }
    .metric { min-height: 7.25rem; }
  }
</style>
