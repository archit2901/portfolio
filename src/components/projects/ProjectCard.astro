---
/**
 * Shared project card. Used by the landing-page Projects section and the
 * standalone /projects page. Visual + interaction patterns mirror Skills:
 * tilt + cursor spotlight + magnet + layered z-depth + reveal hook.
 */
interface Project {
  slug: string;
  name: string;
  tagline: string;
  description: string;
  stack: readonly string[] | string[];
  repoUrl: string;
  liveUrl: string;
  year: string;
  accent: string;
  category: string;
  featured: boolean;
}

interface Props {
  project: Project;
  index: number;
  total: number;
  /** Explicit reveal index — used on the landing-page section (3, 4, 5). */
  revealIndex?: number;
  /** Variable-driven stagger index — used on the /projects page for any N cards. */
  staggerIndex?: number;
}

const { project, index, total, revealIndex, staggerIndex } = Astro.props;

const ACCENT_BAR: Record<string, string> = {
  cyan:   'from-cyan-400/0 via-cyan-300/80 to-cyan-400/0',
  amber:  'from-amber-400/0 via-amber-300/80 to-amber-400/0',
  rose:   'from-rose-400/0 via-rose-300/80 to-rose-400/0',
  violet: 'from-violet-400/0 via-fuchsia-300/80 to-violet-400/0',
};
const ACCENT_BORDER: Record<string, string> = {
  cyan:   'hover:border-cyan-400/50 hover:shadow-[0_8px_24px_-14px_rgba(34,211,238,0.45)]',
  amber:  'hover:border-amber-400/50 hover:shadow-[0_8px_24px_-14px_rgba(251,191,36,0.45)]',
  rose:   'hover:border-rose-400/50 hover:shadow-[0_8px_24px_-14px_rgba(244,63,94,0.45)]',
  violet: 'hover:border-violet-400/50 hover:shadow-[0_8px_24px_-14px_rgba(168,85,247,0.45)]',
};
const ACCENT_DOT: Record<string, string> = {
  cyan:   'bg-cyan-400',
  amber:  'bg-amber-400',
  rose:   'bg-rose-400',
  violet: 'bg-violet-400',
};
const ACCENT_PILL_HOVER: Record<string, string> = {
  cyan:   'hover:text-cyan-300 hover:border-cyan-400/40 hover:bg-cyan-400/[0.06]',
  amber:  'hover:text-amber-300 hover:border-amber-400/40 hover:bg-amber-400/[0.06]',
  rose:   'hover:text-rose-300 hover:border-rose-400/40 hover:bg-rose-400/[0.06]',
  violet: 'hover:text-violet-300 hover:border-violet-400/40 hover:bg-violet-400/[0.06]',
};
const ACCENT_LINK: Record<string, string> = {
  cyan:   'hover:text-cyan-300',
  amber:  'hover:text-amber-300',
  rose:   'hover:text-rose-300',
  violet: 'hover:text-violet-300',
};

const accent = project.accent ?? 'cyan';
const pad2 = (n: number) => String(n).padStart(2, '0');
const cellStyle = staggerIndex !== undefined ? `--reveal-i: ${staggerIndex}` : undefined;
---

<li
  data-category={project.category}
  data-reveal={revealIndex}
  class="pj-cell reveal h-full"
  style={cellStyle}
>
  <article
    class={`pj-card relative h-full flex flex-col rounded-xl bg-bg-subtle/55 backdrop-blur-sm border border-border-subtle p-5 transition-[transform,box-shadow,border-color,opacity] duration-300 hover:-translate-y-0.5 ${ACCENT_BORDER[accent]} overflow-hidden`}
    data-magnet
    data-tilt
    data-accent={accent}
    style="transform: translate(0,0);"
  >
    {/* Top accent gradient bar */}
    <span
      class={`pointer-events-none absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r ${ACCENT_BAR[accent]} z-[3]`}
      aria-hidden="true"
    ></span>

    {/* Cursor-tracking spotlight */}
    <span class="pj-spotlight" aria-hidden="true"></span>

    {/* Index badge */}
    <span
      class="pj-index absolute top-2.5 right-3 font-mono text-[9px] uppercase tracking-[0.18em] text-text-faint/70 select-none"
      aria-hidden="true"
    >
      {pad2(index + 1)} / {pad2(total)}
    </span>

    <div class="pj-card-inner flex flex-col h-full">
      {/* Header */}
      <header class="pj-layer-title flex items-baseline gap-2 pr-12">
        <span class={`block w-2 h-2 rounded-full ${ACCENT_DOT[accent]} shrink-0`} aria-hidden="true"></span>
        <h3 class="text-text-primary text-[17px] md:text-[18px] font-semibold tracking-tight leading-tight">
          {project.name}
        </h3>
      </header>

      {/* Tagline + year */}
      <p class="mt-1.5 text-[12.5px] text-text-muted">{project.tagline}</p>
      <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-text-faint">{project.year}</p>

      {/* Separator */}
      <span class="block border-t border-border-subtle/60 mt-3 mb-3.5" aria-hidden="true"></span>

      {/* Body (description + chips) — collapsible on mobile, full on md+ */}
      <details data-mobile-collapse class="pj-collapse">
        <summary class={`pj-collapse-summary md:hidden list-none cursor-pointer inline-flex items-center gap-2 font-mono text-[11.5px] text-text-muted hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-base rounded-sm`}>
          <span class="pj-collapse-label-closed">Show details</span>
          <span class="pj-collapse-label-open">Hide details</span>
          <svg
            class="pj-chevron transition-transform duration-300"
            width="12" height="12" viewBox="0 0 24 24"
            fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"
            style="display:block"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="pj-collapse-content mt-3 md:mt-0">
          <p class="pj-layer-desc text-[12.5px] sm:text-[13px] leading-snug text-text-muted">{project.description}</p>

          {project.stack.length > 0 && (
            <ul class="pj-layer-chips mt-3.5 flex flex-wrap gap-1.5 list-none p-0">
              {project.stack.map((s) => (
                <li>
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-md font-mono text-[10.5px] text-text-muted border border-border-subtle/80 bg-bg-subtle/40 transition-colors ${ACCENT_PILL_HOVER[accent]}`}>
                    {s}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </details>

      {/* Action row — anchored to bottom */}
      <div class="pj-layer-actions mt-auto pt-4 flex items-center gap-4 text-[12px] font-mono">
        {project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.name} GitHub repository`}
            class={`group/link inline-flex items-center gap-1.5 text-text-muted transition-colors ${ACCENT_LINK[accent]} focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-base rounded-sm`}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:block">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.97.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.56C20.21 21.38 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
            </svg>
            <span>repo</span>
          </a>
        )}
        {project.liveUrl && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.name} live demo`}
            class={`group/link inline-flex items-center gap-1.5 text-text-muted transition-colors ${ACCENT_LINK[accent]} focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-base rounded-sm`}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block">
              <path d="M15 3h6v6"/>
              <path d="M10 14 21 3"/>
              <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>
            </svg>
            <span>live demo</span>
          </a>
        )}
      </div>
    </div>
  </article>
</li>
