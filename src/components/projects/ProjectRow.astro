---
/** One project as a faceplate row. Shared by the home page and /projects. */
import type { Project } from '~/data/projects';
import Icon from '~/components/Icon.astro';

interface Props {
  project: Project;
  /** h3 inside a home-page section; h2 on /projects where the page h1 is the parent. */
  level?: 'h2' | 'h3';
}

const { project: p, level: H = 'h3' } = Astro.props;
---

<article class="pr cut-lg" id={`project-${p.slug}`} data-category={p.category}>
  <div class="pr-id">
    <H class="pr-name">{p.name}</H>
    {p.subtitle && <p class="pr-sub">{p.subtitle}</p>}
    {p.year && <p class="pr-year figure engraved">{p.year}</p>}
  </div>

  <div class="pr-body">
    {p.event && <p class="pr-event well">{p.event}</p>}
    <p class="pr-tag">{p.tagline}</p>
    <p class="pr-desc justify">{p.description}</p>
    <ul class="tags pr-tags" aria-label="Technologies">
      {p.stack.map((t) => <li>{t}</li>)}
    </ul>
  </div>

  {(p.repoUrl || p.liveUrl) && (
    <div class="pr-links">
      {p.repoUrl && (
        <a class="key" href={p.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${p.name} source on GitHub`}>
          <Icon name="github" size={15} />Code
        </a>
      )}
      {p.liveUrl && (
        <a class="key" href={p.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`${p.name} live demo`}>
          Live<Icon name="arrow-up-right" size={15} />
        </a>
      )}
    </div>
  )}
</article>

<style>
  .pr {
    --cut: 16rem;
    display: grid;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
    scroll-margin-top: calc(var(--nav-h) + 1.5rem);
  }
  .pr:target .pr-name::before,
  .pr.is-lit .pr-name::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.625rem;
    vertical-align: 0.2em;
    border-radius: 999px;
    background: rgb(var(--accent));
  }
  .pr:target { animation: lit-row 1.6s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes lit-row {
    0% { background: rgb(var(--accent) / 0.14); }
    100% { background: transparent; }
  }
  .pr-name {
    margin: 0;
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.018em;
    line-height: 1.2;
  }
  .pr-sub {
    margin: 0.25rem 0 0;
    font-weight: 540;
    color: rgb(var(--ink-2));
  }
  .pr-year { margin: 0.5rem 0 0; }
  .pr-event {
    display: inline-block;
    margin: 0 0 0.875rem;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 640;
    font-stretch: 82%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--ink));
  }
  .pr-tag {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.45;
    max-width: 52ch;
  }
  .pr-desc {
    margin: 0.625rem 0 0;
    color: rgb(var(--ink-2));
    max-width: 68ch;
  }
  .pr-tags { margin-top: 1rem; }
  .pr-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    align-content: start;
  }

  @media (min-width: 1024px) {
    .pr {
      grid-template-columns: 15rem minmax(0, 1fr) auto;
      gap: 2rem;
      padding: 2.5rem 0;
    }
    .pr-links { justify-content: flex-end; }
  }
</style>
