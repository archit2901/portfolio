---
import { site } from '~/content/site';
import ProjectCard from './ProjectCard.astro';
import ProjectsRuntime from './ProjectsRuntime.astro';
import AnchorLink from '~/components/AnchorLink.astro';

const { projects } = site;
const featured = projects.items.filter((p) => p.featured).slice(0, 3);
---

<section
  id="projects"
  data-visible="false"
  class="projects-section relative isolate overflow-hidden border-t border-border-subtle/40 px-5 sm:px-8 py-16 sm:py-24 md:py-32 mx-auto w-full max-w-container"
>
  {/* Atmospheric backdrop */}
  <div class="pj-grid" aria-hidden="true"></div>
  <div class="pj-blob" aria-hidden="true"></div>

  {/* Section label */}
  <p
    data-reveal="0"
    class="reveal font-mono text-xs text-text-faint tracking-wider mb-4"
  >
    <span class="text-accent/80">{projects.sectionLabel.split('·')[0].trim()}</span>
    <span class="mx-1.5 text-text-faint/70">·</span>
    <span>{projects.sectionLabel.split('·')[1]?.trim() ?? 'Projects'}</span>
  </p>

  {/* Display heading + animated underline */}
  <h2
    data-reveal="1"
    class="reveal text-text-primary font-semibold tracking-tight text-4xl md:text-5xl lg:text-6xl leading-[1.05]"
  >
    <span>{projects.landingHeading}</span>
    <AnchorLink for="projects" />
  </h2>
  <span data-reveal="2" class="reveal pj-underline" aria-hidden="true"></span>

  {/* Featured cards */}
  <ul class="mt-12 md:mt-14 list-none p-0 grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
    {
      featured.map((p, i) => (
        <ProjectCard
          project={p}
          index={i}
          total={featured.length}
          revealIndex={3 + i}
        />
      ))
    }
  </ul>

  {/* "Browse all" link */}
  <p data-reveal="6" class="reveal mt-8 md:mt-10 text-center">
    <a
      href="/projects"
      class="browse-all group inline-flex items-center gap-2 px-4 py-2 rounded-full font-mono text-[13px] text-text-muted border border-border-subtle hover:text-accent hover:border-accent/50 hover:bg-accent/[0.04] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-base"
    >
      <span>{projects.browseAllLabel}</span>
      <span class="browse-arrow" aria-hidden="true">→</span>
      <span class="font-mono text-text-faint/70 ml-1">({projects.items.length})</span>
    </a>
  </p>
</section>

<ProjectsRuntime />

<style is:global>
  .browse-arrow {
    display: inline-block;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .browse-all:hover .browse-arrow {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .browse-arrow { transition: none; transform: none !important; }
  }
</style>
