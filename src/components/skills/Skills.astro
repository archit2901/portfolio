---
/**
 * Skills, with a spotlight: pressing a skill that the page can prove opens a
 * readout of every bullet and project that used it, and lights those places
 * across the page. Skills with no proof on the site stay plain text.
 */
import { primaryStack, skillGroups } from '~/data/skills';
import { proofs, spotlightPayload } from '~/data/evidence';
import { sectionById } from '~/data/sections';
import SectionHeading from '~/components/SectionHeading.astro';
import Icon from '~/components/Icon.astro';

const s = sectionById('skills');
const payload = JSON.stringify(spotlightPayload()).replace(/</g, '\\u003c');
---

<section id={s.id} class="module" aria-labelledby={`${s.id}-title`}>
  <SectionHeading id={s.id} text={s.heading} />

  <div class="sk-primary" data-proof-home>
    <div class="sk-primary-head">
      <p class="engraved">Primary stack</p>
      <p class="sk-hint">Press a skill to see where I used it</p>
    </div>
    <ul class="sk-keys">
      {primaryStack.map((t) =>
        proofs[t] ? (
          <li>
            <button class="key sk-key" type="button" aria-pressed="false" aria-controls="sk-proof" data-skill={proofs[t].slug}>
              <span class="led" aria-hidden="true"></span>{t}
            </button>
          </li>
        ) : (
          <li class="sk-key sk-key-static well">{t}</li>
        ),
      )}
    </ul>
  </div>

  <dl class="sk-table">
    {skillGroups.map((g) => (
      <div class="sk-row cut-lg">
        <dt class="engraved">{g.title}</dt>
        <dd data-proof-home>
          <ul>
            {g.skills.map((k) =>
              proofs[k] ? (
                <li>
                  <button class="sk-btn" type="button" aria-pressed="false" aria-controls="sk-proof" data-skill={proofs[k].slug}>{k}</button>
                </li>
              ) : (
                <li>{k}</li>
              ),
            )}
          </ul>
        </dd>
      </div>
    ))}
  </dl>

  <div class="sk-proof well" id="sk-proof" role="region" aria-labelledby="sk-proof-title" tabindex="-1" hidden>
    <div class="sk-proof-head">
      <p class="sk-proof-title" id="sk-proof-title">
        <span class="led led-on" aria-hidden="true"></span>
        <span data-proof-name></span>
        <span class="sk-proof-count figure" data-proof-count></span>
      </p>
      <button class="key sk-proof-close" type="button" aria-label="Close skill spotlight" data-proof-close>
        <Icon name="close" size={16} />
      </button>
    </div>
    <ol class="sk-proof-list" data-proof-list></ol>
  </div>
  <p class="sr-only" aria-live="polite" data-proof-status></p>
  <template id="sk-arrow"><Icon name="arrow-right" size={16} /></template>
  <script is:inline type="application/json" id="sk-data" set:html={payload}></script>
</section>

<style>
  .sk-primary { margin-top: 2.25rem; }
  .sk-primary-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }
  .sk-primary-head p { margin: 0; }
  .sk-hint {
    font-size: 0.875rem;
    color: rgb(var(--ink-3));
  }
  .sk-keys {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.875rem 0 0;
    padding: 0;
    list-style: none;
  }
  .sk-key {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.875rem;
    font-size: 1.0625rem;
    font-weight: 680;
    text-align: center;
    cursor: pointer;
  }
  .sk-key .led {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
  }
  .sk-key[aria-pressed='true'] .led {
    background: rgb(var(--accent));
    box-shadow: inset 0 -1px 1px rgb(0 0 0 / 0.18), inset 0 1px 1px rgb(255 255 255 / 0.45);
  }
  .sk-key-static {
    background: rgb(var(--sunk));
    box-shadow: var(--shadow-well);
    cursor: default;
  }

  .sk-table {
    margin: 2.5rem 0 0;
  }
  .sk-row {
    --cut: 16rem;
    display: grid;
    gap: 0.5rem;
    padding: 1.125rem 0;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .sk-row dt { padding-top: 0.25rem; }
  .sk-row dd { margin: 0; }
  .sk-row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.0625rem;
    font-weight: 520;
  }
  .sk-row li:not(:last-child)::after {
    content: '·';
    margin: 0 0.625rem;
    color: rgb(var(--ink-3));
  }

  /* A skill the page can prove: an engraved underline says "press me". */
  .sk-btn {
    margin: -0.1875rem -0.4375rem;
    padding: 0.1875rem 0.4375rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: rgb(var(--ink-3) / 0.32);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
    transition: background-color 120ms ease, box-shadow 120ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sk-btn:hover { text-decoration-color: rgb(var(--ink)); }
  .sk-btn[aria-pressed='true'] {
    background: rgb(var(--sunk));
    box-shadow: var(--shadow-well);
    text-decoration: none;
    font-weight: 640;
  }

  /* The proof readout. */
  .sk-proof {
    margin-top: 1rem;
    padding: 0.875rem 1.125rem 0.375rem;
    border-radius: 1rem;
    outline-offset: 4px;
  }
  .sk-primary .sk-proof { margin-top: 1.25rem; }
  .sk-proof-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    /* Engraved seam drawn inside the box (dark line, then highlight), so a
       half-pixel position can't leave an antialiased edge on the left. */
    border-bottom: 1px solid rgb(var(--seam-hi));
    box-shadow: inset 0 -1px 0 rgb(var(--seam));
  }
  .sk-proof-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .sk-proof-count {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
    color: rgb(var(--ink-3));
  }
  .sk-proof-close {
    width: 2.25rem;
    min-height: 2.25rem;
    padding: 0;
    flex: none;
  }
  .sk-proof-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sk-proof-list :global(li + li) {
    border-top: 1px solid rgb(var(--seam) / 0.8);
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi) / 0.6);
  }
  .sk-proof-list :global(.sk-proof-item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    margin: 0 -0.625rem;
    padding: 0.875rem 0.625rem;
    border-radius: 0.625rem;
    color: inherit;
    text-decoration: none;
  }
  .sk-proof-list :global(.sk-proof-src) { display: grid; gap: 0.125rem; }
  .sk-proof-list :global(.sk-proof-where) { font-weight: 640; color: rgb(var(--ink)); }
  .sk-proof-list :global(.sk-proof-text) {
    grid-column: 1;
    color: rgb(var(--ink-2));
    line-height: 1.55;
  }
  .sk-proof-list :global(.sk-proof-text mark) {
    background: none;
    color: rgb(var(--ink));
    font-weight: 680;
  }
  .sk-proof-list :global(.sk-proof-stack) {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    font-stretch: 82%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--ink-3));
  }
  .sk-proof-list :global(.sk-proof-stack mark) { font-weight: 760; }
  .sk-proof-list :global(.sk-proof-go) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: rgb(var(--ink-3));
    transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), color 120ms ease;
  }
  .sk-proof-list :global(.sk-proof-item:hover) { background: rgb(var(--plate) / 0.55); }
  .sk-proof-list :global(.sk-proof-item:hover .sk-proof-text) { color: rgb(var(--ink)); }
  .sk-proof-list :global(.sk-proof-item:hover .sk-proof-go) { color: rgb(var(--ink)); transform: translateX(2px); }

  @media (min-width: 640px) {
    .sk-keys { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 768px) {
    .sk-proof-list :global(.sk-proof-item) {
      grid-template-columns: 14rem minmax(0, 1fr) auto;
      gap: 1.5rem;
      align-items: baseline;
    }
    .sk-proof-list :global(.sk-proof-text) { grid-column: 2; }
    .sk-proof-list :global(.sk-proof-go) { grid-column: 3; grid-row: 1; align-self: center; }
  }
  @media (min-width: 1024px) {
    .sk-keys { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .sk-row {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-btn, .sk-proof-list :global(.sk-proof-go) { transition: none; }
  }
</style>

<script>
  type Entry = { kind: 'role' | 'project'; title: string; source: string; text: string; stack?: string; href: string };
  type Proof = { skill: string; slug: string; pattern: string; roles: number; projects: number; items: number[] };

  const dataEl = document.getElementById('sk-data');
  const panel = document.getElementById('sk-proof');
  if (dataEl && panel) {
    const data = JSON.parse(dataEl.textContent || '{}') as { entries: Entry[]; skills: Record<string, Proof> };
    const nameEl = panel.querySelector<HTMLElement>('[data-proof-name]')!;
    const countEl = panel.querySelector<HTMLElement>('[data-proof-count]')!;
    const list = panel.querySelector<HTMLOListElement>('[data-proof-list]')!;
    const status = document.querySelector<HTMLElement>('[data-proof-status]')!;
    const arrow = document.getElementById('sk-arrow') as HTMLTemplateElement | null;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('button[data-skill]')];
    let active: string | null = null;
    let opener: HTMLButtonElement | null = null;

    const plural = (n: number, one: string) => `${n} ${one}${n === 1 ? '' : 's'}`;
    const countText = (p: Proof) =>
      [p.roles && plural(p.roles, 'role'), p.projects && plural(p.projects, 'project')].filter(Boolean).join(' · ');

    const marked = (text: string, re: RegExp) => {
      const frag = document.createDocumentFragment();
      let last = 0;
      for (const m of text.matchAll(re)) {
        const i = m.index ?? 0;
        if (i > last) frag.append(text.slice(last, i));
        const mark = document.createElement('mark');
        mark.textContent = m[0];
        frag.append(mark);
        last = i + m[0].length;
      }
      if (last < text.length) frag.append(text.slice(last));
      return frag;
    };

    const unlight = () => document.querySelectorAll('.is-lit').forEach((el) => el.classList.remove('is-lit'));

    const light = (p: Proof, re: RegExp) => {
      unlight();
      for (const i of p.items) {
        const href = data.entries[i].href;
        if (!href.startsWith('#') || href.startsWith('#role-')) continue;
        document.getElementById(href.slice(1))?.classList.add('is-lit');
      }
      document.querySelectorAll<HTMLElement>('.tags li').forEach((li) => {
        re.lastIndex = 0;
        if (re.test(li.textContent || '')) li.classList.add('is-lit');
      });
    };

    const setUrl = (slug: string | null) => {
      const url = new URL(location.href);
      if (slug) url.searchParams.set('skill', slug);
      else url.searchParams.delete('skill');
      history.replaceState(history.state, '', url);
    };

    const render = (p: Proof, label?: string) => {
      const re = new RegExp(p.pattern, 'g');
      nameEl.textContent = label || p.skill;
      countEl.textContent = countText(p);
      list.replaceChildren(
        ...p.items.map((i) => {
          const e = data.entries[i];
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'sk-proof-item';
          a.href = e.href;
          if (e.href.startsWith('#')) a.dataset.xref = '';
          const src = document.createElement('span');
          src.className = 'sk-proof-src';
          const where = document.createElement('span');
          where.className = 'sk-proof-where';
          where.textContent = e.title;
          const from = document.createElement('span');
          from.className = 'engraved';
          from.textContent = e.source;
          src.append(where, from);
          const text = document.createElement('span');
          text.className = 'sk-proof-text';
          text.append(marked(e.text, re));
          if (e.stack) {
            const stack = document.createElement('span');
            stack.className = 'sk-proof-stack';
            stack.append(marked(e.stack, re));
            text.append(stack);
          }
          const go = document.createElement('span');
          go.className = 'sk-proof-go';
          go.setAttribute('aria-hidden', 'true');
          if (arrow) go.append(arrow.content.cloneNode(true));
          a.append(src, text, go);
          li.append(a);
          return li;
        }),
      );
      light(p, new RegExp(p.pattern));
    };

    const close = (restoreFocus = true) => {
      if (!active) return;
      active = null;
      panel.hidden = true;
      buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      unlight();
      setUrl(null);
      status.textContent = '';
      if (restoreFocus) opener?.focus();
    };

    const open = (slug: string, from: HTMLButtonElement | null) => {
      const p = data.skills[slug];
      if (!p) return;
      active = slug;
      opener = from ?? buttons.find((b) => b.dataset.skill === slug) ?? null;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.skill === slug)));
      render(p, from?.textContent?.trim());
      // The readout opens right under the group the pressed skill sits in.
      const home = opener?.closest('[data-proof-home]');
      if (home && panel.parentElement !== home) home.append(panel);
      panel.hidden = false;
      setUrl(slug);
      status.textContent = `${p.skill}: used in ${countText(p).replace(' · ', ' and ')}.`;
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const slug = b.dataset.skill!;
        if (active === slug) close();
        else open(slug, b);
      }),
    );
    panel.querySelector('[data-proof-close]')?.addEventListener('click', () => close());
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !active) return;
      const t = e.target as Element | null;
      if (t && (panel.contains(t) || t.closest('button[data-skill]'))) close();
    });

    const initial = new URL(location.href).searchParams.get('skill');
    if (initial && data.skills[initial]) {
      open(initial, null);
      requestAnimationFrame(() => document.getElementById('skills')?.scrollIntoView({ block: 'start' }));
    }
  }
</script>
