---
import '~/styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import CommandPalette from '~/components/command/CommandPalette.astro';
import OnboardingToast from '~/components/OnboardingToast.astro';
import CustomCursor from '~/components/CustomCursor.astro';
import { site } from '~/content/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ?? site.meta.title;
const pageDescription = description ?? site.meta.description;

// Canonical URL — Astro.site is set in astro.config.mjs
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://architgupta.me').toString();
const ogImageUrl = site.meta.ogImage
  ? new URL(site.meta.ogImage, Astro.site ?? 'https://architgupta.me').toString()
  : null;

// Structured data — Person schema for SEO + recruiter ATS pipelines
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.toString() ?? 'https://architgupta.me',
  jobTitle: 'Software Engineer',
  description: pageDescription,
  email: site.hero.socials.find((s) => s.label === 'Email')?.href.replace(/^mailto:/, '') ?? '',
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Northeastern University' },
    { '@type': 'CollegeOrUniversity', name: 'Guru Gobind Singh Indraprastha University' },
  ],
  sameAs: site.hero.socials
    .filter((s) => s.href.startsWith('http'))
    .map((s) => s.href),
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <meta name="generator" content={Astro.generator} />

    {/* Structured data — Person schema */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    {/* Scroll progress bar */}
    <div class="scroll-progress" aria-hidden="true"></div>

    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <OnboardingToast />
    <CustomCursor />

    {/* Anchor-copy toast — shared across every <AnchorLink> on the page */}
    <div
      id="anchor-toast"
      role="status"
      aria-live="polite"
      data-state="hidden"
      class="anchor-toast pointer-events-none fixed bottom-5 left-1/2 -translate-x-1/2 z-[58]
             flex items-center gap-2 px-3.5 py-2 rounded-full border border-accent/40 bg-bg-subtle/85 backdrop-blur-md
             font-mono text-[12px] text-accent
             opacity-0 translate-y-2 transition-[opacity,transform] duration-200 ease-out
             data-[state=shown]:opacity-100 data-[state=shown]:translate-y-0"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span>Link copied</span>
    </div>

    {/* Privacy-friendly pageview analytics (Vercel Web Analytics) */}
    <Analytics />

    {/* Console signature for visiting devs */}
    <script is:inline>
      (() => {
        const head = 'color:#22d3ee;font-size:14px;font-weight:600;padding:4px 0;';
        const body = 'color:#9ca3af;font-size:12px;line-height:1.6;';
        const link = 'color:#67e8f9;';
        const kbd  = 'color:#67e8f9;background:#111;padding:1px 5px;border-radius:3px;border:1px solid #222;';
        console.log('%c👋  hey, dev.', head);
        console.log('%csite source: %chttps://github.com/archit2901/portfolio', body, link);
        console.log('%cbuilt with: %castro 5 · tailwind · three.js', body, link);
        console.log('%cpress %c⌘K%c to navigate', body, kbd, body);
      })();
    </script>

    {/* Anchor-copy click handler — shared across all <AnchorLink> instances */}
    <script is:inline>
      (() => {
        const toast = document.getElementById('anchor-toast');
        let hideTimer = 0;
        const showToast = () => {
          if (!toast) return;
          toast.setAttribute('data-state', 'shown');
          clearTimeout(hideTimer);
          hideTimer = window.setTimeout(() => {
            toast.setAttribute('data-state', 'hidden');
          }, 1400);
        };
        const onClick = async (e) => {
          const a = e.target instanceof Element ? e.target.closest('[data-anchor-copy]') : null;
          if (!a) return;
          e.preventDefault();
          const target = a.getAttribute('data-anchor-target') || '';
          const url = window.location.origin + window.location.pathname + '#' + target;
          let ok = false;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(url);
              ok = true;
            }
          } catch (_) {}
          if (!ok) {
            const ta = document.createElement('textarea');
            ta.value = url;
            ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); } catch (_) {}
            ta.remove();
          }
          a.classList.add('copied');
          setTimeout(() => a.classList.remove('copied'), 900);
          // Update the URL hash silently so the visitor can re-copy from the bar.
          try { history.replaceState(null, '', '#' + target); } catch (_) {}
          showToast();
        };
        document.addEventListener('click', onClick);
      })();
    </script>

    {/* Tab-title swap when the page becomes hidden */}
    <script is:inline>
      (() => {
        const original = document.title;
        const messages = ['👋 come back?', "Archit's still here."];
        let timer = 0;
        let i = 0;
        const tick = () => {
          if (document.visibilityState !== 'hidden') return;
          document.title = messages[i % messages.length];
          i += 1;
          timer = window.setTimeout(tick, 3000);
        };
        document.addEventListener('visibilitychange', () => {
          clearTimeout(timer);
          i = 0;
          if (document.visibilityState === 'hidden') {
            timer = window.setTimeout(tick, 800);
          } else {
            document.title = original;
          }
        });
      })();
    </script>

    {/* Scroll restoration on back navigation */}
    <script is:inline>
      (() => {
        // Disable the browser's automatic guess so our explicit restore wins.
        if ('scrollRestoration' in history) {
          try { history.scrollRestoration = 'manual'; } catch (_) {}
        }
        const KEY = 'scroll:' + location.pathname;
        const save = () => {
          try { sessionStorage.setItem(KEY, String(window.scrollY)); } catch (_) {}
        };
        const restore = () => {
          let y = 0;
          try { y = parseInt(sessionStorage.getItem(KEY) || '0', 10); } catch (_) {}
          if (y > 0) {
            // Defer past the post-load paint so layout is settled.
            requestAnimationFrame(() => window.scrollTo(0, y));
          }
        };
        window.addEventListener('pageshow', restore);
        window.addEventListener('beforeunload', save);
        window.addEventListener('pagehide', save);
      })();
    </script>

    {/* Scroll progress driver */}
    <script is:inline>
      (() => {
        const bar = document.querySelector('.scroll-progress');
        if (!bar) return;
        let raf = 0;
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          bar.style.transform = `scaleX(${p})`;
        };
        const onScroll = () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>

    <style is:global>
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        z-index: 60;
        background: linear-gradient(90deg, #22d3ee, #a855f7);
        transform-origin: 0 50%;
        transform: scaleX(0);
        pointer-events: none;
        will-change: transform;
        transition: transform 80ms linear;
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress { transition: none; }
      }
    </style>
  </body>
</html>
