---
import '~/styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import CommandPalette from '~/components/command/CommandPalette.astro';
import { profile, links } from '~/data/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ?? profile.meta.title;
const pageDescription = description ?? profile.meta.description;

const siteUrl = Astro.site ?? new URL(profile.siteUrl);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(profile.meta.ogImage, siteUrl).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: siteUrl.toString(),
  jobTitle: 'Full-stack & AI Software Engineer',
  description: pageDescription,
  email: links.email,
  image: new URL(profile.about.headshot.src, siteUrl).toString(),
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Northeastern University' },
    { '@type': 'CollegeOrUniversity', name: 'Guru Gobind Singh Indraprastha University' },
  ],
  sameAs: [links.github, links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (_) {}
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'dark' : 'light';
        var rm = false;
        try { rm = localStorage.getItem('pref-reduce-motion') === 'true'; if (rm) root.dataset.reduceMotion = 'true'; } catch (_) {}
        // Power-on sequence: home page, once per session, never under reduced motion or on a deep link.
        try {
          var home = location.pathname === '/' || location.pathname === '';
          var calm = rm || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (home && !calm && !location.hash && !/[?&]skill=/.test(location.search) && !sessionStorage.getItem('powered-on')) {
            root.classList.add('boot');
            sessionStorage.setItem('powered-on', '1');
            setTimeout(function () { root.classList.remove('boot'); }, 2600);
          }
        } catch (_) {}
      })();
    </script>
    <meta name="theme-color" content="#DCDCD7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100F0E" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Archit Gupta, Full-stack & AI engineer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a href="#main" class="skip key">Skip to content</a>
    <div class="plate">
      <Navbar />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <CommandPalette />

    <div id="toast" role="status" aria-live="polite" data-state="hidden" class="toast well">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
      <span data-toast-text>Link copied</span>
    </div>

    <Analytics />

    <script is:inline>
      (() => {
        // ── Theme switch: system by default, manual choice persists. ──────
        const root = document.documentElement;
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        const paint = (theme) => {
          document.querySelectorAll('[data-theme-switch]').forEach((el) => {
            el.setAttribute('aria-checked', String(theme === 'dark'));
          });
        };
        const set = (theme, persist) => {
          root.classList.add('theme-switching');
          root.dataset.theme = theme;
          paint(theme);
          if (persist) { try { localStorage.setItem('theme', theme); } catch (_) {} }
          window.setTimeout(() => root.classList.remove('theme-switching'), 260);
        };
        window.__toggleTheme = () => set(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
        mq.addEventListener('change', (e) => {
          let stored = null;
          try { stored = localStorage.getItem('theme'); } catch (_) {}
          if (!stored) set(e.matches ? 'dark' : 'light', false);
        });
        document.addEventListener('click', (e) => {
          const sw = e.target instanceof Element ? e.target.closest('[data-theme-switch]') : null;
          if (sw) window.__toggleTheme();
        });
        paint(root.dataset.theme);

        // ── Toast shared by copy-link and copy-email. ─────────────────────
        const toast = document.getElementById('toast');
        const toastText = toast && toast.querySelector('[data-toast-text]');
        let hideTimer = 0;
        window.__toast = (msg) => {
          if (!toast || !toastText) return;
          toastText.textContent = msg;
          toast.dataset.state = 'shown';
          clearTimeout(hideTimer);
          hideTimer = window.setTimeout(() => { toast.dataset.state = 'hidden'; }, 1600);
        };
        window.__copy = async (text) => {
          try {
            if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(text); return true; }
          } catch (_) {}
          const ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          let ok = false;
          try { ok = document.execCommand('copy'); } catch (_) {}
          ta.remove();
          return ok;
        };

        // ── Copy section links. ───────────────────────────────────────────
        document.addEventListener('click', async (e) => {
          const a = e.target instanceof Element ? e.target.closest('[data-anchor-copy]') : null;
          if (!a) return;
          e.preventDefault();
          const id = a.getAttribute('data-anchor-target') || '';
          await window.__copy(location.origin + location.pathname + '#' + id);
          a.classList.add('copied');
          setTimeout(() => a.classList.remove('copied'), 900);
          try { history.replaceState(null, '', '#' + id); } catch (_) {}
          window.__toast('Link copied');
        });

        // ── Cross-references: a stat key opens any collapsed bullet it points at. ──
        const reveal = (hash, scroll) => {
          if (!hash || hash.length < 2) return;
          let el = null;
          try { el = document.getElementById(decodeURIComponent(hash.slice(1))); } catch (_) {}
          const det = el && el.closest('details');
          if (det && !det.open) {
            det.open = true;
            if (scroll) el.scrollIntoView({ block: 'start' });
          }
        };
        document.addEventListener('click', (e) => {
          const a = e.target instanceof Element ? e.target.closest('a[data-xref]') : null;
          if (a) reveal(a.getAttribute('href'));
        });
        window.addEventListener('hashchange', () => reveal(location.hash, true));
        reveal(location.hash, true);

        console.log('%cArchit Gupta', 'font:700 14px system-ui;color:#EE5A12');
        console.log('%cSource: https://github.com/archit2901/portfolio · Press ⌘K to navigate', 'font:12px system-ui;color:#5E6166');
      })();
    </script>

    <style is:global>
      .skip {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 200;
      }
      .skip:focus { top: 1rem; }
      .toast {
        position: fixed;
        left: 50%;
        bottom: 1.25rem;
        z-index: 120;
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.625rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: rgb(var(--ink));
        border-radius: 0.75rem;
        transform: translate(-50%, 0.5rem);
        opacity: 0;
        pointer-events: none;
        transition: opacity 180ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .toast[data-state='shown'] { opacity: 1; transform: translate(-50%, 0); }
    </style>
  </body>
</html>
