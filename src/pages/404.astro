---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import { sections } from '~/data/sections';
import { profile } from '~/data/profile';
---

<BaseLayout title={`Page not found | ${profile.name}`} description="Page not found.">
  <section class="nf" aria-labelledby="nf-title">
    <p class="nf-readout well figure"><span class="led" aria-hidden="true"></span>404 · <span id="nf-path">this page</span> does not exist</p>
    <h1 id="nf-title" class="h-section">Nothing at this address.</h1>
    <p class="nf-lead">The page may have moved. Everything on the site is one of these:</p>
    <ul class="nf-links">
      <li><a class="key key-dark" href="/"><Icon name="arrow-right" size={16} class="nf-ico" />Home</a></li>
      <li><a class="key" href="/projects">Projects</a></li>
      {sections.filter((s) => ['experience', 'contact'].includes(s.id)).map((s) => (
        <li><a class="key" href={`/#${s.id}`}>{s.label}</a></li>
      ))}
      <li><a class="key" href="/resume.pdf">Résumé</a></li>
    </ul>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const el = document.getElementById('nf-path');
    if (el && location.pathname && location.pathname !== '/404') el.textContent = location.pathname;
  })();
</script>

<style>
  .nf {
    min-height: 60vh;
    padding: clamp(3rem, 8vw, 6rem) var(--pad);
    max-width: 48rem;
  }
  .nf-readout {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1.5rem;
    padding: 0.625rem 1rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .nf-lead { margin: 1.25rem 0 0; font-size: 1.1875rem; color: rgb(var(--ink-2)); }
  .nf-links { display: flex; flex-wrap: wrap; gap: 0.625rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .nf-links :global(.nf-ico) { transform: rotate(180deg); }
</style>
