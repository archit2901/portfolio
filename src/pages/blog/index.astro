---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import { profile, links } from '~/data/profile';
---

<BaseLayout
  title={`Blog (coming soon) | ${profile.name}`}
  description="Notes on full-stack engineering, AI tools, and shipping. Coming soon."
>
  <section class="bl" aria-labelledby="bl-title">
    <a href="/" class="bl-back"><Icon name="arrow-right" size={16} class="bl-back-ico" />Home</a>
    <div class="bl-body">
      <p class="bl-status well"><span class="led" aria-hidden="true"></span>Not live yet</p>
      <h1 id="bl-title" class="h-section">Coming soon.</h1>
      <p class="bl-lead">
        I'm collecting notes on full-stack engineering, AI tooling, and the small craft decisions that compound. The blog will live here when the first few posts are ready.
      </p>
      <div class="bl-keys">
        <a class="key" href="/projects">See projects<Icon name="arrow-right" size={16} /></a>
        <a class="key" href={links.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} />GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bl {
    min-height: 60vh;
    padding: clamp(2rem, 4vw, 3.5rem) var(--pad) clamp(3rem, 6vw, 5rem);
  }
  .bl-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: rgb(var(--ink-2));
    text-decoration: none;
    padding: 0.5rem 0;
  }
  .bl-back:hover { color: rgb(var(--ink)); }
  .bl-back :global(.bl-back-ico) { transform: rotate(180deg); }
  .bl-body { max-width: 40rem; margin-top: clamp(2rem, 6vw, 4rem); }
  .bl-status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.625rem;
    font-weight: 600;
    font-size: 0.875rem;
  }
  .bl-lead { margin: 1.25rem 0 0; font-size: 1.1875rem; color: rgb(var(--ink-2)); }
  .bl-keys { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-top: 2rem; }
</style>
