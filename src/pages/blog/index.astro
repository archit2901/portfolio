---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/content/site';

const pageTitle = `${site.name} — Blog (coming soon)`;
const pageDescription = "Notes on full-stack engineering, AI tools, and shipping. Coming soon.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section
    data-visible="false"
    class="blog-page relative isolate overflow-hidden px-5 sm:px-8 py-16 md:py-24 mx-auto w-full max-w-container min-h-[calc(100vh-12rem)] flex flex-col"
  >
    {/* Atmospheric backdrop */}
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-blob" aria-hidden="true"></div>

    {/* Back to home */}
    <p data-reveal="0" class="reveal">
      <a
        href="/"
        class="back-link group inline-flex items-center gap-1.5 font-mono text-[12px] text-text-faint hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-base rounded-sm"
      >
        <span class="back-arrow" aria-hidden="true">←</span>
        <span>Back to home</span>
      </a>
    </p>

    <div class="flex-1 flex flex-col justify-center max-w-[58ch] mx-auto w-full py-12">
      {/* Section label */}
      <p
        data-reveal="1"
        class="reveal font-mono text-xs text-text-faint tracking-wider mb-4"
      >
        <span class="text-accent/80">08</span>
        <span class="mx-1.5 text-text-faint/70">·</span>
        <span>Blog</span>
      </p>

      {/* Heading + underline */}
      <h1
        data-reveal="2"
        class="reveal text-text-primary font-semibold tracking-tight text-4xl md:text-5xl lg:text-6xl leading-[1.05]"
      >
        Coming soon.
      </h1>
      <span data-reveal="3" class="reveal blog-underline" aria-hidden="true"></span>

      {/* Status pill */}
      <p
        data-reveal="4"
        class="reveal mt-8 inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-accent/30 bg-accent/[0.05] font-mono text-[12.5px] text-accent w-fit"
      >
        <span class="block w-2 h-2 rounded-full bg-accent wordmark-dot" aria-hidden="true"></span>
        <span>Drafts in progress · first post lands this year</span>
      </p>

      {/* Lead line */}
      <p
        data-reveal="5"
        class="reveal mt-8 text-text-muted text-[15px] md:text-base leading-relaxed"
      >
        I'm collecting notes on full-stack engineering, AI tooling, and the small craft decisions that compound. The blog will live here when the first few posts are ready.
      </p>

      {/* Terminal-style "topics" block — same vocabulary as the hero */}
      <div
        data-reveal="6"
        class="reveal mt-8 max-w-md p-3.5 rounded-md border border-border-subtle bg-bg-subtle/60 backdrop-blur-sm font-mono text-[12px] leading-[1.7] text-text-muted overflow-hidden break-words"
      >
        {/* macOS dots */}
        <div class="flex items-center gap-1 mb-3" aria-hidden="true">
          <span class="block w-2 h-2 rounded-full bg-traffic-red/80"></span>
          <span class="block w-2 h-2 rounded-full bg-traffic-yellow/80"></span>
          <span class="block w-2 h-2 rounded-full bg-traffic-green/80"></span>
        </div>
        <div>
          <span class="text-accent">archit</span><span class="text-text-faint"> @ </span><span class="text-text-primary">portfolio</span><span class="text-text-faint">:~$ </span>
          <span class="text-text-primary">ls ./drafts</span>
        </div>
        <div class="text-text-muted mt-1">
          building-with-go.md     <span class="text-text-faint">  ~ 80%</span>
        </div>
        <div class="text-text-muted">
          claude-as-pair.md       <span class="text-text-faint">  ~ 60%</span>
        </div>
        <div class="text-text-muted">
          three-js-tricks.md      <span class="text-text-faint">  ~ 40%</span>
        </div>
        <div class="text-text-muted">
          ey-ai-postmortem.md     <span class="text-text-faint">  ~ 20%</span>
        </div>
        <div class="mt-2">
          <span class="text-accent">archit</span><span class="text-text-faint"> @ </span><span class="text-text-primary">portfolio</span><span class="text-text-faint">:~$ </span>
          <span class="term-cursor">█</span>
        </div>
      </div>

      {/* Secondary CTA */}
      <p
        data-reveal="7"
        class="reveal mt-8 font-mono text-[12.5px] text-text-faint"
      >
        Until then, find me on
        <a
          href="https://github.com/archit2901"
          target="_blank"
          rel="noopener noreferrer"
          class="mx-1 text-text-muted hover:text-accent transition-colors"
        >GitHub</a>
        or
        <a
          href="https://linkedin.com/in/archit2901"
          target="_blank"
          rel="noopener noreferrer"
          class="mx-1 text-text-muted hover:text-accent transition-colors"
        >LinkedIn</a>.
      </p>
    </div>
  </section>

  <style is:global>
    /* Atmospheric backdrop — top-right blob (different corner from the home sections) */
    .blog-page .bg-grid {
      position: absolute;
      inset: 0;
      z-index: -2;
      background-image:
        radial-gradient(circle at 1px 1px, rgba(34, 211, 238, 0.10) 1px, transparent 0);
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 25%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 25%, transparent 80%);
    }
    .blog-page .bg-blob {
      position: absolute;
      z-index: -1;
      top: -160px;
      right: -100px;
      width: 540px;
      height: 460px;
      border-radius: 9999px;
      background: conic-gradient(from 220deg, rgba(34,211,238,0.20), rgba(168,85,247,0.18), rgba(34,211,238,0.20));
      filter: blur(70px);
      opacity: 0.55;
      pointer-events: none;
    }

    /* Heading underline */
    .blog-underline {
      display: block;
      margin-top: 18px;
      height: 2px;
      width: 0;
      border-radius: 2px;
      background: linear-gradient(90deg, #22d3ee, #a855f7);
      transition: width 900ms cubic-bezier(0.22, 1, 0.36, 1) 300ms;
      will-change: width;
    }
    .blog-page[data-visible='true'] .blog-underline { width: 120px; }

    /* Reveal cascade */
    .blog-page .reveal {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
                  transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .blog-page[data-visible='true'] .reveal { opacity: 1; transform: translateY(0); }
    .blog-page[data-visible='true'] .reveal[data-reveal='0'] { transition-delay:   0ms; }
    .blog-page[data-visible='true'] .reveal[data-reveal='1'] { transition-delay:  80ms; }
    .blog-page[data-visible='true'] .reveal[data-reveal='2'] { transition-delay: 150ms; }
    .blog-page[data-visible='true'] .reveal[data-reveal='3'] { transition-delay: 220ms; }
    .blog-page[data-visible='true'] .reveal[data-reveal='4'] { transition-delay: 300ms; }
    .blog-page[data-visible='true'] .reveal[data-reveal='5'] { transition-delay: 380ms; }
    .blog-page[data-visible='true'] .reveal[data-reveal='6'] { transition-delay: 460ms; }
    .blog-page[data-visible='true'] .reveal[data-reveal='7'] { transition-delay: 540ms; }

    /* Back-link arrow micro-anim */
    .back-arrow {
      display: inline-block;
      transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .back-link:hover .back-arrow {
      transform: translateX(-3px);
    }

    @media (prefers-reduced-motion: reduce) {
      .blog-page .reveal { opacity: 1; transform: none; transition: none; }
      .blog-underline { width: 120px; transition: none; }
      .back-arrow { transition: none; transform: none !important; }
    }
  </style>

  <script>
    const section = document.querySelector<HTMLElement>('section.blog-page');
    if (section) {
      // Trigger reveal on load (no scroll needed — single-screen page)
      requestAnimationFrame(() => {
        section.dataset.visible = 'true';
      });
    }
  </script>
</BaseLayout>
