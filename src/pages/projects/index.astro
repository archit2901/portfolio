---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProjectRow from '~/components/projects/ProjectRow.astro';
import Icon from '~/components/Icon.astro';
import { projects, projectCategories, featuredOrder } from '~/data/projects';
import { profile } from '~/data/profile';

// Featured first (in featured order), then the rest as listed.
const ordered = [
  ...featuredOrder.map((slug) => projects.find((p) => p.slug === slug)).filter((p) => p !== undefined),
  ...projects.filter((p) => !featuredOrder.includes(p.slug)),
];
const counts = Object.fromEntries(projectCategories.map((c) => [c.key, projects.filter((p) => p.category === c.key).length]));
---

<BaseLayout
  title={`Projects | ${profile.name}`}
  description={`All projects by ${profile.name}: agentic RAG, real-time data pipelines, Go services, and web apps.`}
>
  <section class="pp" aria-labelledby="pp-title">
    <a href="/" class="pp-back"><Icon name="arrow-right" size={16} class="pp-back-ico" />Home</a>
    <div class="pp-head">
      <h1 id="pp-title" class="h-section">Projects</h1>
      <div class="pp-filter well" role="group" aria-label="Filter by category">
        <button type="button" class="pp-opt" aria-pressed="true" data-filter="all">All <span class="figure">{projects.length}</span></button>
        {projectCategories.map((c) => (
          <button type="button" class="pp-opt" aria-pressed="false" data-filter={c.key}>{c.title} <span class="figure">{counts[c.key]}</span></button>
        ))}
      </div>
    </div>
    <p class="pp-count engraved" aria-live="polite" data-pp-count>{projects.length} projects</p>
    <div class="pp-list" data-pp-list>
      {ordered.map((p) => <ProjectRow project={p} level="h2" />)}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const opts = Array.from(document.querySelectorAll('[data-filter]'));
    const rows = Array.from(document.querySelectorAll('[data-pp-list] .pr'));
    const count = document.querySelector('[data-pp-count]');
    const apply = (key) => {
      let n = 0;
      rows.forEach((r) => {
        const show = key === 'all' || r.getAttribute('data-category') === key;
        r.hidden = !show;
        if (show) n += 1;
      });
      opts.forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.filter === key)));
      if (count) count.textContent = n + (n === 1 ? ' project' : ' projects');
    };
    opts.forEach((o) => o.addEventListener('click', () => apply(o.dataset.filter || 'all')));
  })();
</script>

<style>
  .pp {
    padding: clamp(2rem, 4vw, 3.5rem) var(--pad) clamp(3rem, 6vw, 5rem);
  }
  .pp-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: rgb(var(--ink-2));
    text-decoration: none;
    padding: 0.5rem 0;
  }
  .pp-back:hover { color: rgb(var(--ink)); }
  .pp-back :global(.pp-back-ico) { transform: rotate(180deg); }
  .pp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .pp-filter {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.3125rem;
    border-radius: 0.875rem;
  }
  .pp-opt {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.875rem;
    border: 0;
    border-radius: 0.625rem;
    background: transparent;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(var(--ink-2));
    cursor: pointer;
    transition: background-color 160ms ease, box-shadow 160ms ease, color 160ms ease;
  }
  .pp-opt .figure { font-size: 0.8125rem; color: rgb(var(--ink-3)); }
  .pp-opt[aria-pressed='true'] {
    background: rgb(var(--raised));
    box-shadow: var(--shadow-key);
    color: rgb(var(--ink));
  }
  .pp-count { margin: 2rem 0 0; }
  .pp-list { margin-top: 1rem; }
  .pp-list :global(.pr[hidden]) { display: none; }
</style>
