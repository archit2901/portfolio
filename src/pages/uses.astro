---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import { uses } from '~/data/uses';
import { profile } from '~/data/profile';
---

<BaseLayout title={`Uses | ${profile.name}`} description={uses.lead}>
  <section class="us" aria-labelledby="us-title">
    <a href="/" class="us-back"><Icon name="arrow-right" size={16} class="us-back-ico" />Home</a>
    <h1 id="us-title" class="h-section us-h">{uses.heading}</h1>
    <p class="us-lead">{uses.lead}</p>

    <div class="us-groups">
      {uses.groups.map((g) => (
        <section class="us-row cut-md" aria-label={g.title}>
          <h2 class="engraved us-g">{g.title}</h2>
          <dl class="us-items">
            {g.items.map((it) => (
              <div>
                <dt>{it.name}</dt>
                <dd>{it.note}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .us {
    padding: clamp(2rem, 4vw, 3.5rem) var(--pad) clamp(3rem, 6vw, 5rem);
  }
  .us-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: rgb(var(--ink-2));
    text-decoration: none;
    padding: 0.5rem 0;
  }
  .us-back:hover { color: rgb(var(--ink)); }
  .us-back :global(.us-back-ico) { transform: rotate(180deg); }
  .us-h { margin-top: 1rem; }
  .us-lead {
    margin: 1.25rem 0 0;
    max-width: 56ch;
    font-size: 1.1875rem;
    color: rgb(var(--ink-2));
  }
  .us-groups { margin-top: 2.5rem; }
  .us-row {
    display: grid;
    gap: 0.75rem;
    padding: 1.75rem 0;
    border-top: 1px solid rgb(var(--seam));
    box-shadow: inset 0 1px 0 rgb(var(--seam-hi));
  }
  .us-g { margin: 0; padding-top: 0.25rem; font-size: 0.75rem; }
  .us-items { margin: 0; display: grid; gap: 1rem; }
  .us-items dt { font-weight: 680; }
  .us-items dd { margin: 0.125rem 0 0; color: rgb(var(--ink-2)); max-width: 64ch; }
  @media (min-width: 768px) {
    .us-row { grid-template-columns: 13rem minmax(0, 1fr); gap: 2.5rem; }
    .us-items { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; }
  }
</style>
